</div>

<script>
/* ═══════════════════════════════════════════════════════════════
   CORE STATE
   ═══════════════════════════════════════════════════════════════ */
const APP_ID = 1089;
const WS_URL = `wss://ws.binaryws.com/websockets/v3?app_id=${APP_ID}`;

const App = {
  state: {
    authenticated: false, isDemo: false, token: null,
    balance: 0, currency: 'USD', loginid: '', email: '', fullname: 'Trader', isVirtual: true,
    todayPnl: 0, wins: 0, losses: 0, openContracts: [], history: [], savedAccounts: [], soundEnabled: true
  }
};

/* ═══════════════════════════════════════════════════════════════
   WEBSOCKET
   ═══════════════════════════════════════════════════════════════ */
const WS = {
  socket: null, connected: false, listeners: {}, queue: [],
  connect() {
    if (this.socket && (this.socket.readyState === WebSocket.CONNECTING || this.socket.readyState === WebSocket.OPEN)) return;
    this.socket = new WebSocket(WS_URL);
    this.socket.onopen = () => {
      this.connected = true;
      while (this.queue.length) this.send(this.queue.shift());
      if (App.state.token) this.send({ authorize: App.state.token });
      else if (App.state.isDemo) Markets.loadAll();
    };
    this.socket.onmessage = (e) => this.handle(JSON.parse(e.data));
    this.socket.onclose = () => { this.connected = false; setTimeout(() => this.connect(), 3000); };
  },
  send(msg) { if (!this.connected || !this.socket || this.socket.readyState !== WebSocket.OPEN) { this.queue.push(msg); return; } this.socket.send(JSON.stringify(msg)); },
  on(event, cb) { if (!this.listeners[event]) this.listeners[event] = []; this.listeners[event].push(cb); },
  handle(data) {
    if (data.error) { UI.notify(data.error.message, 'error'); return; }
    const type = Object.keys(data).find(k => !['echo_req','req_id','subscription'].includes(k));
    if (this.listeners[type]) this.listeners[type].forEach(cb => cb(data[type], data));
  }
};

/* ═══════════════════════════════════════════════════════════════
   AUTHENTICATION
   ═══════════════════════════════════════════════════════════════ */
const Auth = {
  init() { const saved = localStorage.getItem('kht_accounts'); if (saved) App.state.savedAccounts = JSON.parse(saved); this.renderSaved(); },
  showModal() { document.getElementById('auth-modal').classList.add('active'); document.getElementById('auth-token-input').focus(); },
  hideModal() { document.getElementById('auth-modal').classList.remove('active'); document.getElementById('auth-error').textContent = ''; },
  login() {
    const token = document.getElementById('auth-token-input').value.trim();
    if (!token) { document.getElementById('auth-error').textContent = 'Enter a valid API token'; return; }
    this.setLoading(true);
    App.state.token = token; App.state.isDemo = false;
    WS.connect(); setTimeout(() => WS.send({ authorize: token }), 500);
    setTimeout(() => { if (!App.state.authenticated) { this.setLoading(false); document.getElementById('auth-error').textContent = 'Connection timeout.'; } }, 6000);
  },
  setLoading(v) {
    document.getElementById('auth-btn').disabled = v;
    document.getElementById('auth-spinner').style.display = v ? 'block' : 'none';
    document.getElementById('auth-btn-text').textContent = v ? 'Connecting...' : 'Connect Account';
    document.getElementById('auth-btn-icon').style.display = v ? 'none' : 'inline-block';
  },
  enterDemo() {
    App.state.isDemo = true; App.state.authenticated = true; App.state.balance = 10000; App.state.currency = 'USD';
    App.state.loginid = 'VRTC-DEMO'; App.state.isVirtual = true; App.state.fullname = 'Demo Trader';
    this.hideModal(); document.getElementById('entry-gate').classList.add('hidden'); UI.showApp(); UI.updateAccount();
    Markets.loadAll(); WS.connect(); UI.notify('Demo mode active. Trades simulated with real market data.');
  },
  logout() {
    App.state.authenticated = false; App.state.isDemo = false; App.state.token = null; App.state.balance = 0;
    App.state.openContracts = []; App.state.history = []; App.state.todayPnl = 0; App.state.wins = 0; App.state.losses = 0;
    if (WS.socket) WS.socket.close();
    document.getElementById('app-shell').classList.remove('active'); document.getElementById('entry-gate').classList.remove('hidden');
    UI.updateAccount(); UI.renderPositions(); UI.renderHistory(); UI.renderDashboard(); BotBuilder.stop();
  },
  saveAccount(token, auth) {
    const exists = App.state.savedAccounts.find(a => a.token === token);
    if (!exists) { App.state.savedAccounts.push({ token, loginid: auth.loginid, currency: auth.currency, isVirtual: auth.is_virtual, name: auth.fullname || auth.email || 'Account' }); localStorage.setItem('kht_accounts', JSON.stringify(App.state.savedAccounts)); this.renderSaved(); }
  },
  renderSaved() {
    const wrap = document.getElementById('saved-accounts-wrap'), list = document.getElementById('saved-accounts-list');
    if (!App.state.savedAccounts.length) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'block';
    list.innerHTML = App.state.savedAccounts.map(a => `
      <div style="display:flex;align-items:center;justify-content:space-between;background:#091509;border:1px solid #1a3a1a;border-radius:6px;padding:0.5rem 0.7rem;margin-bottom:0.4rem;cursor:pointer;" onclick="Auth.useSaved('${a.token}')">
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <div style="width:28px;height:28px;border-radius:50%;background:${a.isVirtual?'linear-gradient(135deg,#f59e0b,#d97706)':'linear-gradient(135deg,#10b981,#059669)'};display:flex;align-items:center;justify-content:center;color:#fff;font-size:0.7rem;font-weight:700;">${a.name.charAt(0).toUpperCase()}</div>
          <div><div style="font-size:0.78rem;font-weight:600;color:#c8e6c9;">${a.name}</div><div style="font-size:0.65rem;color:#4a7a4a;font-family:monospace;">${a.loginid}</div></div>
        </div>
        <button onclick="event.stopPropagation();Auth.removeSaved('${a.token}')" style="background:none;border:none;color:#4a7a4a;cursor:pointer;font-size:0.8rem;"><i class="fas fa-times"></i></button>
      </div>
    `).join('');
  },
  useSaved(token) { document.getElementById('auth-token-input').value = token; this.login(); },
  removeSaved(token) { App.state.savedAccounts = App.state.savedAccounts.filter(a => a.token !== token); localStorage.setItem('kht_accounts', JSON.stringify(App.state.savedAccounts)); this.renderSaved(); },
  toggleDropdown() { document.getElementById('acc-dropdown').classList.toggle('show'); }
};

WS.on('authorize', (auth) => {
  App.state.authenticated = true; App.state.currency = auth.currency || 'USD'; App.state.loginid = auth.loginid;
  App.state.isVirtual = auth.is_virtual; App.state.balance = auth.balance; App.state.email = auth.email;
  App.state.fullname = auth.fullname || auth.email || 'Trader'; Auth.saveAccount(App.state.token, auth);
  Auth.hideModal(); document.getElementById('entry-gate').classList.add('hidden'); UI.showApp(); UI.updateAccount();
  WS.send({ balance: 1, subscribe: 1 }); WS.send({ transaction: 1, subscribe: 1 }); WS.send({ account_list: 1 });
  Markets.loadAll(); UI.notify(`Authorized as ${auth.loginid}`);
});

WS.on('balance', (bal) => { App.state.balance = parseFloat(bal.balance); UI.updateBalance(); });

WS.on('account_list', (list) => {
  const conn = document.getElementById('acc-connected-list');
  const other = document.getElementById('acc-other-list');
  if (!list || !list.length) return;
  const current = list.find(a => a.loginid === App.state.loginid);
  const others = list.filter(a => a.loginid !== App.state.loginid);
  if (current) {
    conn.innerHTML = `<div class="acc-card active">
      <div class="acc-card-icon ${current.is_virtual?'demo':'real'}">${current.currency.charAt(0)}</div>
      <div class="acc-card-info"><div class="acc-card-type">${current.currency} Wallet</div><div class="acc-card-name">${current.loginid}</div></div>
      <div class="acc-card-balance">${App.state.balance.toFixed(2)}</div>
    </div>`;
  }
  other.innerHTML = others.map(a => `<div class="acc-card" onclick="UI.notify('Connect with token for ${a.loginid}')">
    <div class="acc-card-icon ${a.is_virtual?'demo':'real'}">${a.currency.charAt(0)}</div>
    <div class="acc-card-info"><div class="acc-card-type">${a.currency} Wallet</div><div class="acc-card-name">${a.loginid}</div></div>
  </div>`).join('');
});

/* ═══════════════════════════════════════════════════════════════
   MARKETS
   ═══════════════════════════════════════════════════════════════ */
const Markets = {
  symbols: [], categories: {}, activeSymbol: 'R_100', ticks: {}, tickHistory: {},
  loadAll() { WS.send({ active_symbols: 'brief', product_type: 'basic' }); },
  handleSymbols(data) {
    this.symbols = (data.active_symbols || []).filter(s => s.exchange_is_open !== 0);
    this.categories = {};
    const catMap = { synthetic_index: { name: 'Derived Indices', icon: 'fa-bolt' }, forex: { name: 'Forex', icon: 'fa-exchange-alt' }, indices: { name: 'Stock Indices', icon: 'fa-chart-bar' }, commodities: { name: 'Commodities', icon: 'fa-coins' } };
    this.symbols.forEach(s => { const key = s.market; if (!this.categories[key]) this.categories[key] = { ...catMap[key], items: [] }; this.categories[key].items.push(s); });
    this.populateSelects(); UI.renderMarkets(); this.subscribe(this.activeSymbol);
  },
  populateSelects() {
    const opts = Object.values(this.categories).map(c => `<optgroup label="${c.name}">${c.items.map(s => `<option value="${s.symbol}" ${s.symbol===this.activeSymbol?'selected':''}>${s.display_name}</option>`).join('')}</optgroup>`).join('');
    ['ticket-symbol'].forEach(id => { const el = document.getElementById(id); if (el) el.innerHTML = opts; });
  },
  subscribe(symbol) { if (!symbol) return; this.activeSymbol = symbol; WS.send({ forget_all: 'ticks' }); WS.send({ ticks: symbol, subscribe: 1 }); WS.send({ ticks_history: symbol, adjust_start_time: 1, count: 100, end: 'latest', start: 1, style: 'ticks' }); },
  handleTick(tick) {
    if (!tick || !tick.quote) return;
    const sym = tick.symbol, price = tick.quote, prev = this.ticks[sym] ? this.ticks[sym].price : price;
    this.ticks[sym] = { price, epoch: tick.epoch, prev };
    if (!this.tickHistory[sym]) this.tickHistory[sym] = [];
    this.tickHistory[sym].push({ price, epoch: tick.epoch });
    if (this.tickHistory[sym].length > 300) this.tickHistory[sym].shift();
    if (sym === this.activeSymbol) {
      document.getElementById('trade-price').textContent = price.toFixed(tick.pip_size || 2);
      const change = price - prev;
      document.getElementById('trade-change').innerHTML = `<span style="color:${change>=0?'var(--green)':'var(--red)'}">${change>=0?'+':''}${change.toFixed(tick.pip_size||2)}</span>`;
      Charts.drawTradeChart(this.tickHistory[sym]);
      document.getElementById('bb-chart-symbol').textContent = sym;
      Charts.drawBotChart(this.tickHistory[sym]);
    }
  },
  filter(term) { const t = term.toLowerCase(); document.querySelectorAll('.market-item').forEach(el => { el.style.display = el.textContent.toLowerCase().includes(t) ? 'flex' : 'none'; }); }
};

WS.on('active_symbols', (d) => Markets.handleSymbols(d));
WS.on('tick', (d) => Markets.handleTick(d));
WS.on('history', (d) => { if (d && d.prices && d.times) { const sym = d.echo_req.ticks_history; Markets.tickHistory[sym] = d.prices.map((p,i) => ({ price: p, epoch: d.times[i] })); if (sym === Markets.activeSymbol) { Charts.drawTradeChart(Markets.tickHistory[sym]); Charts.drawBotChart(Markets.tickHistory[sym]); } } });

/* ═══════════════════════════════════════════════════════════════
   TRADE ENGINE
   ═══════════════════════════════════════════════════════════════ */
const Trade = {
  currentProposal: null, pendingDirection: null,
  onSymbolChange() { const sym = document.getElementById('ticket-symbol').value; Markets.subscribe(sym); const s = Markets.symbols.find(x => x.symbol === sym); document.getElementById('trade-symbol-name').textContent = s ? s.display_name : sym; document.getElementById('trade-symbol-code').textContent = sym; },
  execute(direction) {
    if (!App.state.authenticated) { UI.notify('Connect or enter demo mode first'); return; }
    const symbol = document.getElementById('ticket-symbol').value;
    const duration = parseInt(document.getElementById('ticket-dur').value) || 1;
    const durationUnit = document.getElementById('ticket-dur-unit').value;
    const stake = parseFloat(document.getElementById('ticket-stake').value) || 0.35;
    let contractType = document.getElementById('ticket-type').value;
    if (direction === 'up' && (contractType === 'CALL' || contractType === 'PUT')) contractType = 'CALL';
    else if (direction === 'down' && (contractType === 'CALL' || contractType === 'PUT')) contractType = 'PUT';
    const req = { proposal: 1, amount: stake, basis: 'stake', contract_type: contractType, currency: App.state.currency, duration: duration, duration_unit: durationUnit, symbol: symbol };
    this.pendingDirection = direction; this.currentProposal = null; WS.send(req); UI.notify('Requesting proposal...');
  },
  handleProposal(proposal) {
    if (!proposal || !proposal.id) { UI.notify('Proposal failed'); return; }
    this.currentProposal = proposal;
    if (App.state.isDemo) { this.simulateContract(proposal); return; }
    WS.send({ buy: proposal.id, price: proposal.ask_price });
  },
  handleBuy(buy) {
    if (!buy || !buy.contract_id) { UI.notify('Purchase failed'); return; }
    const contract = { id: buy.contract_id, symbol: buy.symbol || Markets.activeSymbol, type: buy.contract_type || this.currentProposal?.contract_type || 'Unknown', stake: parseFloat(buy.buy_price || this.currentProposal?.ask_price || 0), entryPrice: Markets.ticks[Markets.activeSymbol]?.price || 0, entryTime: Date.now(), status: 'OPEN', longcode: buy.longcode || '' };
    App.state.openContracts.push(contract);
    WS.send({ proposal_open_contract: 1, contract_id: buy.contract_id, subscribe: 1 });
    UI.renderPositions(); UI.updateDashboard(); UI.notify(`Contract #${buy.contract_id} purchased`);
  },
  handleContractUpdate(poc) {
    const c = App.state.openContracts.find(x => x.id === poc.contract_id);
    if (!c) return;
    c.profit = parseFloat(poc.profit || 0); c.status = (poc.is_expired || poc.is_sold) ? 'CLOSED' : 'OPEN';
    if (c.status === 'CLOSED') {
      App.state.openContracts = App.state.openContracts.filter(x => x.id !== c.id);
      App.state.todayPnl += c.profit; App.state.history.unshift({ time: new Date().toLocaleString(), id: c.id, symbol: c.symbol, type: c.type, stake: c.stake, entry: c.entryPrice, exit: 0, profit: c.profit, status: c.profit >= 0 ? 'WON' : 'LOST' });
      if (c.profit >= 0) App.state.wins++; else App.state.losses++;
      UI.renderPositions(); UI.renderHistory(); UI.updateDashboard(); UI.notify(`${c.profit >= 0 ? 'WIN' : 'LOSS'}: ${c.profit >= 0 ? '+' : ''}${c.profit.toFixed(2)}`);
    } else {
      const plEl = document.getElementById(`pos-pl-${c.id}`);
      if (plEl) { plEl.textContent = (c.profit >= 0 ? '+' : '') + c.profit.toFixed(2); plEl.className = 'pos-pl ' + (c.profit >= 0 ? 'green' : 'red'); }
    }
  },
  simulateContract(proposal) {
    const cfg = { symbol: proposal.echo_req.symbol, contract_type: proposal.echo_req.contract_type, duration: proposal.echo_req.duration, duration_unit: proposal.echo_req.duration_unit, stake: proposal.echo_req.amount };
    const entryPrice = Markets.ticks[cfg.symbol]?.price || 0;
    const fakeId = 'DEMO-' + Date.now();
    const contract = { id: fakeId, symbol: cfg.symbol, type: cfg.contract_type, stake: cfg.stake, entryPrice, entryTime: Date.now(), status: 'OPEN', profit: 0, longcode: `[DEMO] ${cfg.contract_type} ${cfg.symbol}` };
    App.state.openContracts.push(contract); UI.renderPositions(); UI.notify('[DEMO] Contract opened');
    setTimeout(() => {
      const hist = Markets.tickHistory[cfg.symbol]; const exitTick = hist && hist.length > 0 ? hist[hist.length - 1] : { price: entryPrice };
      let isWin = Math.random() > 0.45;
      const profit = isWin ? (cfg.stake * 0.88) : -cfg.stake;
      contract.profit = profit; contract.status = 'CLOSED';
      App.state.openContracts = App.state.openContracts.filter(x => x.id !== fakeId);
      App.state.todayPnl += profit; App.state.history.unshift({ time: new Date().toLocaleString(), id: fakeId, symbol: cfg.symbol, type: cfg.contract_type, stake: cfg.stake, entry: entryPrice, exit: 0, profit, status: isWin ? 'WON' : 'LOST' });
      if (isWin) App.state.wins++; else App.state.losses++;
      UI.renderPositions(); UI.renderHistory(); UI.updateDashboard(); UI.notify(`[DEMO] ${isWin ? 'WIN' : 'LOSS'} ${profit >= 0 ? '+' : ''}${profit.toFixed(2)}`);
    }, 3000);
  }
};

WS.on('proposal', (d) => Trade.handleProposal(d));
WS.on('buy', (d) => Trade.handleBuy(d));
WS.on('proposal_open_contract', (d) => Trade.handleContractUpdate(d));

/* ═══════════════════════════════════════════════════════════════
   BOT EDITOR
   ═══════════════════════════════════════════════════════════════ */
const BotEditor = {
  switchTab(tab, el) { document.querySelectorAll('.rp-tab').forEach(t => t.classList.remove('active')); el.classList.add('active'); document.querySelectorAll('.rp-content').forEach(c => c.style.display = 'none'); document.getElementById('rp-' + tab).style.display = 'block'; },
  loadQuick() { UI.switchTab('botbuilder'); BotBuilder.loadQuick('martingale'); },
  resetStats() { document.getElementById('rp-stake').textContent = '0.00 USD'; document.getElementById('rp-payout').textContent = '0.00 USD'; document.getElementById('rp-lost').textContent = '0'; document.getElementById('rp-won').textContent = '0'; document.getElementById('rp-pnl').textContent = '0.00 USD'; UI.notify('Stats reset'); }
};

/* ═══════════════════════════════════════════════════════════════
   BOT BUILDER
   ═══════════════════════════════════════════════════════════════ */
const BotBuilder = {
  running: false, stats: { stake: 0, payout: 0, wins: 0, losses: 0, pnl: 0 }, blocks: [], timer: null,
  toggleCat(el) { const items = el.nextElementSibling; if (items) { items.classList.toggle('hidden'); el.classList.toggle('collapsed'); } },
  filterBlocks(term) { const t = term.toLowerCase(); document.querySelectorAll('.bb-toolbox-item').forEach(item => { item.style.display = item.textContent.toLowerCase().includes(t) ? 'flex' : 'none'; }); },
  switchTab(tab, el) { document.querySelectorAll('.bb-runpanel-tab').forEach(t => t.classList.remove('active')); el.classList.add('active'); document.querySelectorAll('.bb-runpanel-content').forEach(c => c.style.display = 'none'); document.getElementById('bb-panel-' + tab).style.display = 'block'; },
  addBlock(type) {
    const stack = document.getElementById('bb-stack');
    if (stack.children.length === 1 && stack.children[0].querySelector('.fa-cubes')) stack.innerHTML = '';
    const block = document.createElement('div'); block.className = 'bb-block'; block.id = 'block-' + Date.now();
    const headers = { trade_params: ['blue','fa-sliders-h','Trade Parameters'], purchase: ['green','fa-shopping-cart','Purchase Condition'], restart: ['purple','fa-redo','Restart Condition'], notify: ['orange','fa-bell','Notification'] };
    const h = headers[type] || ['blue','fa-cube','Block'];
    block.innerHTML = `<div class="bb-block-header ${h[0]}"><i class="fas ${h[1]}"></i> ${h[2]}<button style="margin-left:auto;background:none;border:none;color:#fff;cursor:pointer;font-size:0.8rem;" onclick="this.closest('.bb-block').remove()"><i class="fas fa-times"></i></button></div><div class="bb-block-body" id="${block.id}-body"></div>`;
    const body = block.querySelector('.bb-block-body');
    if (type === 'trade_params') {
      body.innerHTML = `<div class="bb-field"><label>Symbol</label><select class="bb-field-select" id="${block.id}-sym">${document.getElementById('ticket-symbol').innerHTML}</select></div>
      <div class="bb-field"><label>Contract</label><select class="bb-field-select" id="${block.id}-type"><option value="CALL">Rise</option><option value="PUT">Fall</option></select></div>
      <div class="bb-field"><label>Stake</label><input type="number" class="bb-field-input" value="1.00" id="${block.id}-stake"></div>`;
    } else if (type === 'restart') {
      body.innerHTML = `<div class="bb-field"><label>Max Loss</label><input type="number" class="bb-field-input" value="5.00" id="${block.id}-sl"></div>
      <div class="bb-field"><label>Take Profit</label><input type="number" class="bb-field-input" value="10.00" id="${block.id}-tp"></div>`;
    }
    stack.appendChild(block); this.blocks.push({ id: block.id, type });
  },
  loadQuick(strategy) {
    document.getElementById('bb-stack').innerHTML = ''; this.blocks = [];
    this.addBlock('trade_params'); this.addBlock('purchase'); this.addBlock('restart');
    this.log(`Loaded quick strategy: ${strategy}`, 'info');
  },
  run() {
    if (this.running) return; if (!App.state.authenticated) { UI.notify('Connect or enter demo mode first'); return; }
    this.running = true;
    document.getElementById('bb-run-btn').style.display = 'none'; document.getElementById('bb-stop-btn').style.display = 'inline-flex';
    document.getElementById('run-bar-btn').innerHTML = '<i class="fas fa-stop"></i> Stop'; document.getElementById('run-bar-btn').onclick = () => this.stop();
    document.getElementById('bb-status').innerHTML = '<span class="status-dot" style="width:8px;height:8px;border-radius:50%;background:var(--green);display:inline-block;box-shadow:0 0 8px var(--green);"></span> Bot is running...'; document.getElementById('bb-status').classList.add('running');
    document.getElementById('run-bar-status').textContent = 'Bot is running'; document.getElementById('run-bar-status').classList.add('running');
    this.log('Bot started', 'info'); this.executeLoop();
  },
  stop() {
    this.running = false; if (this.timer) clearTimeout(this.timer);
    document.getElementById('bb-run-btn').style.display = 'inline-flex'; document.getElementById('bb-stop-btn').style.display = 'none';
    document.getElementById('run-bar-btn').innerHTML = '<i class="fas fa-play"></i> Run'; document.getElementById('run-bar-btn').onclick = () => this.run();
    document.getElementById('bb-status').innerHTML = '<span class="status-dot" style="width:8px;height:8px;border-radius:50%;background:var(--text-muted);display:inline-block;"></span> Bot is not running'; document.getElementById('bb-status').classList.remove('running');
    document.getElementById('run-bar-status').textContent = 'Bot is not running'; document.getElementById('run-bar-status').classList.remove('running');
    this.log('Bot stopped', 'info');
  },
  reset() { this.stop(); document.getElementById('bb-stack').innerHTML = '<div style="text-align:center;color:var(--text-muted);padding:3rem;"><i class="fas fa-cubes" style="font-size:2.5rem;margin-bottom:1rem;display:block;opacity:0.3;"></i><p>Your strategy workspace is empty.</p></div>'; this.blocks = []; this.resetStats(); this.log('Workspace reset', 'info'); },
  executeLoop() {
    if (!this.running) return;
    const tp = this.blocks.find(b => b.type === 'trade_params');
    if (!tp) { this.log('No Trade Parameters block', 'loss'); this.stop(); return; }
    const sym = document.getElementById(tp.id + '-sym')?.value || 'R_100';
    const type = document.getElementById(tp.id + '-type')?.value || 'CALL';
    const stake = parseFloat(document.getElementById(tp.id + '-stake')?.value) || 0.35;
    Markets.subscribe(sym);
    WS.send({ proposal: 1, amount: stake, basis: 'stake', contract_type: type, currency: App.state.currency, duration: 1, duration_unit: 't', symbol: sym });
    this.log(`Proposal: ${type} ${sym} @ ${stake}`, 'info');
    this.timer = setTimeout(() => this.executeLoop(), 3000);
  },
  handleBotProposal(proposal) {
    if (!this.running || !proposal || !proposal.id) return;
    if (App.state.isDemo) { Trade.simulateContract(proposal); this.updateBotStats(proposal); return; }
    WS.send({ buy: proposal.id, price: proposal.ask_price }); this.updateBotStats(proposal);
  },
  updateBotStats(proposal) {
    this.stats.stake += parseFloat(proposal.ask_price || 0); this.stats.payout += parseFloat(proposal.payout || 0);
    document.getElementById('bb-sum-stake').textContent = this.stats.stake.toFixed(2);
    document.getElementById('bb-sum-payout').textContent = this.stats.payout.toFixed(2);
    document.getElementById('rp-stake').textContent = this.stats.stake.toFixed(2) + ' USD';
    document.getElementById('rp-payout').textContent = this.stats.payout.toFixed(2) + ' USD';
  },
  updateBotResult(profit) {
    this.stats.pnl += profit; if (profit >= 0) this.stats.wins++; else this.stats.losses++;
    document.getElementById('bb-sum-wins').textContent = this.stats.wins; document.getElementById('bb-sum-losses').textContent = this.stats.losses;
    document.getElementById('rp-won').textContent = this.stats.wins; document.getElementById('rp-lost').textContent = this.stats.losses;
    const total = this.stats.wins + this.stats.losses;
    document.getElementById('bb-sum-winrate').textContent = total > 0 ? Math.round((this.stats.wins/total)*100) + '%' : '0%';
    const pnlEl = document.getElementById('bb-sum-pnl'); pnlEl.textContent = (this.stats.pnl >= 0 ? '+' : '') + this.stats.pnl.toFixed(2); pnlEl.style.color = this.stats.pnl >= 0 ? 'var(--green)' : 'var(--red)';
    document.getElementById('rp-pnl').textContent = (this.stats.pnl >= 0 ? '+' : '') + this.stats.pnl.toFixed(2) + ' USD'; document.getElementById('rp-pnl').style.color = this.stats.pnl >= 0 ? 'var(--green)' : 'var(--red)';
    this.log(`${profit >= 0 ? 'WIN' : 'LOSS'} ${profit >= 0 ? '+' : ''}${profit.toFixed(2)}`, profit >= 0 ? 'win' : 'loss');
  },
  resetStats() { this.stats = { stake: 0, payout: 0, wins: 0, losses: 0, pnl: 0 }; document.getElementById('bb-sum-stake').textContent = '0.00'; document.getElementById('bb-sum-payout').textContent = '0.00'; document.getElementById('bb-sum-wins').textContent = '0'; document.getElementById('bb-sum-losses').textContent = '0'; document.getElementById('bb-sum-winrate').textContent = '0%'; document.getElementById('bb-sum-pnl').textContent = '0.00'; document.getElementById('bb-sum-pnl').style.color = 'var(--text)'; document.getElementById('rp-stake').textContent = '0.00 USD'; document.getElementById('rp-payout').textContent = '0.00 USD'; document.getElementById('rp-won').textContent = '0'; document.getElementById('rp-lost').textContent = '0'; document.getElementById('rp-pnl').textContent = '0.00 USD'; document.getElementById('rp-pnl').style.color = 'var(--text)'; },
  log(msg, type = 'info') {
    const log = document.getElementById('bb-journal-log');
    if (!log.innerHTML || log.textContent.includes('Journal is empty')) log.innerHTML = '';
    const entry = document.createElement('div'); entry.style.cssText = 'padding:0.2rem 0;border-bottom:1px solid var(--border-light);font-family:var(--font-mono);font-size:0.75rem;';
    entry.innerHTML = `<span style="color:var(--text-muted);font-size:0.65rem;">${new Date().toLocaleTimeString()}</span> <span style="color:${type==='win'?'var(--green)':type==='loss'?'var(--red)':'var(--text-secondary)'};font-weight:${type==='win'||type==='loss'?700:400};">${msg}</span>`;
    log.appendChild(entry); log.scrollTop = log.scrollHeight;
  }
};

const origHandleBuy = Trade.handleBuy.bind(Trade);
Trade.handleBuy = function(buy) { origHandleBuy(buy); if (BotBuilder.running) BotBuilder.log(`BUY Contract #${buy.contract_id}`, 'buy'); };
const origHandleContract = Trade.handleContractUpdate.bind(Trade);
Trade.handleContractUpdate = function(poc) { const wasOpen = App.state.openContracts.find(x => x.id === poc.contract_id); origHandleContract(poc); if (BotBuilder.running && wasOpen && wasOpen.status === 'OPEN' && (poc.is_expired || poc.is_sold)) BotBuilder.updateBotResult(wasOpen.profit); };

WS.on('proposal', (d) => BotBuilder.handleBotProposal(d));

/* ═══════════════════════════════════════════════════════════════
   CHARTS
   ═══════════════════════════════════════════════════════════════ */
const Charts = {
  drawTradeChart(ticks) {
    const canvas = document.getElementById('trade-chart');
    if (!canvas || !ticks || ticks.length < 2) return;
    const ctx = canvas.getContext('2d'), w = canvas.width = canvas.offsetWidth, h = canvas.height = canvas.offsetHeight;
    ctx.clearRect(0, 0, w, h);
    const prices = ticks.map(t => t.price), min = Math.min(...prices), max = Math.max(...prices), range = max - min || 1, pad = 20;
    ctx.strokeStyle = '#e8eaed'; ctx.lineWidth = 1;
    for (let i = 1; i < 5; i++) { const y = pad + (i/5)*(h-pad*2); ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(w-pad,y); ctx.stroke(); }
    const grad = ctx.createLinearGradient(0,0,0,h); grad.addColorStop(0,'rgba(0,167,158,0.12)'); grad.addColorStop(1,'rgba(0,167,158,0.02)');
    ctx.fillStyle = grad; ctx.beginPath();
    ticks.forEach((t,i) => { const x = pad+(i/(ticks.length-1))*(w-pad*2), y = h-pad-((t.price-min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.lineTo(w-pad,h-pad); ctx.lineTo(pad,h-pad); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = '#00a79e'; ctx.lineWidth = 2; ctx.beginPath();
    ticks.forEach((t,i) => { const x = pad+(i/(ticks.length-1))*(w-pad*2), y = h-pad-((t.price-min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.stroke();
  },
  drawBotChart(ticks) {
    const canvas = document.getElementById('bb-chart');
    if (!canvas || !ticks || ticks.length < 2) return;
    const ctx = canvas.getContext('2d'), w = canvas.width = canvas.offsetWidth, h = canvas.height = canvas.offsetHeight;
    ctx.clearRect(0,0,w,h);
    const prices = ticks.map(t => t.price), min = Math.min(...prices), max = Math.max(...prices), range = max - min || 1, pad = 10;
    ctx.strokeStyle = '#00a79e'; ctx.lineWidth = 1.5; ctx.beginPath();
    ticks.forEach((t,i) => { const x = pad+(i/(ticks.length-1))*(w-pad*2), y = h-pad-((t.price-min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.stroke();
  }
};

/* ═══════════════════════════════════════════════════════════════
   UI CONTROLLER
   ═══════════════════════════════════════════════════════════════ */
const UI = {
  showApp() { document.getElementById('app-shell').classList.add('active'); },
  switchTab(name, el) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.getElementById('panel-' + name).classList.add('active');
    document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
    document.querySelectorAll('.sub-nav-link').forEach(i => i.classList.remove('active'));
    if (el) { el.classList.add('active'); } else {
      const sub = document.querySelector(`.sub-nav-link[onclick*="'${name}'"]`);
      if (sub) sub.classList.add('active');
      const side = document.querySelector(`.sidebar-item[onclick*="'${name}'"]`);
      if (side) side.classList.add('active');
    }
  },
  updateAccount() {
    document.getElementById('sidebar-name').textContent = App.state.fullname.split(' ')[0] || 'Trader';
    document.getElementById('sidebar-id').textContent = App.state.loginid || 'Disconnected';
    document.getElementById('sidebar-avatar').textContent = (App.state.fullname || 'T').charAt(0).toUpperCase();
    this.updateBalance();
  },
  updateBalance() {
    const bal = App.state.balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('header-balance').textContent = bal + ' ' + App.state.currency;
    document.getElementById('dash-wallet-balance').textContent = bal;
    document.getElementById('dash-wallet-label').textContent = (App.state.isVirtual || App.state.isDemo ? 'Demo' : 'Real') + ' ' + App.state.currency + ' wallet';
    document.getElementById('header-badge').textContent = App.state.isVirtual || App.state.isDemo ? 'Demo' : 'Real';
    document.getElementById('header-badge').className = 'acc-badge ' + (App.state.isVirtual || App.state.isDemo ? 'demo' : 'real');
  },
  updateDashboard() {
    const total = App.state.wins + App.state.losses;
    const winRate = total > 0 ? Math.round((App.state.wins / total) * 100) : 0;
    const pnlEl = document.getElementById('dash-pnl');
    pnlEl.textContent = (App.state.todayPnl >= 0 ? '+' : '') + App.state.todayPnl.toFixed(2);
    pnlEl.className = 'stat-value ' + (App.state.todayPnl >= 0 ? 'positive' : 'negative');
    document.getElementById('dash-winrate').textContent = winRate + '%';
    document.getElementById('dash-open').textContent = App.state.openContracts.length;
  },
  renderPositions() {
    const grid = document.getElementById('positions-grid');
    document.getElementById('pos-count').textContent = `(${App.state.openContracts.length})`;
    if (!App.state.openContracts.length) { grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:3rem;">No open positions</div>'; return; }
    grid.innerHTML = App.state.openContracts.map(c => `<div class="pos-card"><div style="display:flex;justify-content:space-between;align-items:center;"><div><div style="font-weight:700;">${c.symbol}</div><div style="font-size:0.7rem;color:var(--text-muted);">${c.type} • ${c.stake.toFixed(2)}</div></div><span class="badge badge-open">OPEN</span></div><div class="pos-pl ${(c.profit||0)>=0?'green':'red'}" id="pos-pl-${c.id}">${(c.profit||0)>=0?'+':''}${(c.profit||0).toFixed(2)}</div><div style="font-size:0.75rem;color:var(--text-muted);">#${String(c.id).slice(-6)}</div></div>`).join('');
  },
  renderHistory() {
    const tbody = document.getElementById('history-tbody');
    if (!App.state.history.length) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:2rem;">No closed trades yet</td></tr>'; return; }
    tbody.innerHTML = App.state.history.map(h => `<tr><td style="font-size:0.75rem;">${h.time}</td><td style="font-family:var(--font-mono);font-size:0.75rem;">${String(h.id).slice(-8)}</td><td>${h.symbol}</td><td>${h.type}</td><td>${h.stake.toFixed(2)}</td><td style="color:${h.profit>=0?'var(--green)':'var(--red)'};font-weight:600;">${h.profit>=0?'+':''}${h.profit.toFixed(2)}</td><td><span class="badge ${h.status==='WON'?'badge-win':'badge-loss'}">${h.status}</span></td></tr>`).join('');
  },
  renderMarkets() {
    const container = document.getElementById('markets-container');
    const catMap = { synthetic_index: { name: 'Derived Indices', icon: 'fa-bolt' }, forex: { name: 'Forex', icon: 'fa-exchange-alt' }, indices: { name: 'Stock Indices', icon: 'fa-chart-bar' }, commodities: { name: 'Commodities', icon: 'fa-coins' } };
    container.innerHTML = Object.keys(Markets.categories).map(key => { const cat = Markets.categories[key]; const info = catMap[key] || { name: key, icon: 'fa-circle' }; return `<div class="market-cat-title"><i class="fas ${info.icon}" style="color:var(--green);margin-right:0.5rem;"></i> ${info.name}</div><div class="market-grid">${cat.items.map(s => `<div class="market-item ${Markets.activeSymbol===s.symbol?'active':''}" onclick="Markets.subscribe('${s.symbol}');UI.switchTab('trading');"><div><div class="market-name">${s.display_name}</div><div class="market-code">${s.symbol}</div></div><i class="fas fa-chart-line" style="color:var(--text-muted);font-size:0.8rem;"></i></div>`).join('')}</div>`; }).join('');
  },
  notify(msg, type = 'success') {
    const n = document.getElementById('notif'); const icon = n.querySelector('i');
    icon.className = type === 'error' ? 'fas fa-exclamation-circle' : 'fas fa-check-circle';
    icon.style.color = type === 'error' ? 'var(--red)' : 'var(--green)';
    document.getElementById('notif-text').textContent = msg; n.classList.add('show');
    setTimeout(() => n.classList.remove('show'), 3500);
  },
  toggleFullscreen() { if (!document.fullscreenElement) document.documentElement.requestFullscreen(); else document.exitFullscreen(); }
};

