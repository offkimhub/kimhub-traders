      <div class="panel" id="panel-copy"><div class="card" style="text-align:center;padding:3rem;"><i class="fas fa-users" style="font-size:3rem;color:var(--border);margin-bottom:1rem;"></i><p style="color:var(--text-muted);">Copy Trading panel coming soon.</p></div></div>
      <div class="panel" id="panel-reports"><div class="card" style="text-align:center;padding:3rem;"><i class="fas fa-file-alt" style="font-size:3rem;color:var(--border);margin-bottom:1rem;"></i><p style="color:var(--text-muted);">Reports panel coming soon.</p></div></div>

