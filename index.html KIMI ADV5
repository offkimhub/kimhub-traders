    <div style="display:flex;align-items:center;justify-content:space-between;padding:0.8rem 1rem;background:linear-gradient(135deg,#7b1fa2,#a855f7);color:#fff;">
      <span style="font-weight:700;font-size:0.9rem;"><i class="fas fa-robot" style="margin-right:0.4rem;"></i> KimHub AI</span>
      <button onclick="AI.toggle()" style="background:none;border:none;color:#fff;cursor:pointer;font-size:1rem;"><i class="fas fa-times"></i></button>
