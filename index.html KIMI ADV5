      <input type="text" id="ai-input" placeholder="Ask AI..." style="flex:1;padding:0.4rem 0.6rem;border:1px solid var(--border);border-radius:6px;font-size:0.8rem;outline:none;" onkeypress="if(event.key==='Enter')AI.send()">
      <button onclick="AI.send()" style="background:var(--purple);color:#fff;border:none;padding:0 0.8rem;border-radius:6px;cursor:pointer;"><i class="fas fa-paper-plane"></i></button>
