      <div class="bb-field-row"><span class="bb-field-label">Martingale</span><input type="checkbox" id="${block.id}-mart" style="accent-color:var(--accent-green);width:16px;height:16px;"></div>`;
    } else if (type === 'sell') {
      body.innerHTML = `<div class="bb-field-row"><span class="bb-field-label">If Profit ></span><input type="number" class="bb-field-input" value="0.50" id="${block.id}-sellat"></div>`;
