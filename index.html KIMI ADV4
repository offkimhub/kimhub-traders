    const headers = { trade_params: ['blue', 'fa-sliders-h', 'Trade Parameters'], purchase: ['green', 'fa-shopping-cart', 'Purchase Condition'], restart: ['purple', 'fa-redo', 'Restart Trading Conditions'], sell: ['orange', 'fa-hand-paper', 'Sell Condition'], notify: ['orange', 'fa-bell', 'Notification'], variable: ['blue', 'fa-database', 'Set Variable'], rsi: ['purple', 'fa-wave-square', 'RSI Check'], ma: ['green', 'fa-chart-line', 'Moving Average'] };
    const h = headers[type] || ['blue', 'fa-cube', 'Block'];
