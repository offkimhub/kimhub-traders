    document.getElementById('bb-sum-winrate').textContent = total > 0 ? Math.round((this.stats.wins/total)*100) + '%' : '0%';
    const pnlEl = document.getElementById('bb-sum-pnl'); pnlEl.textContent = (this.stats.pnl >= 0 ? '+' : '') + this.stats.pnl.toFixed(2); pnlEl.style.color = this.stats.pnl >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';
    this.log(`${profit >= 0 ? 'WIN' : 'LOSS'} ${profit >= 0 ? '+' : ''}${profit.toFixed(2)}`, profit >= 0 ? 'win' : 'loss');
  },
  resetStats() { this.stats = { stake: 0, payout: 0, wins: 0, losses: 0, pnl: 0 }; document.getElementById('bb-sum-stake').textContent = '0.00'; document.getElementById('bb-sum-payout').textContent = '0.00'; document.getElementById('bb-sum-wins').textContent = '0'; document.getElementById('bb-sum-losses').textContent = '0'; document.getElementById('bb-sum-winrate').textContent = '0%'; document.getElementById('bb-sum-pnl').textContent = '0.00'; document.getElementById('bb-sum-pnl').style.color = 'var(--text-primary)'; },
