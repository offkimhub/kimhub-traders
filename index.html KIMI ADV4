const Charts = {
  drawTradeChart(ticks) {
    const canvas = document.getElementById('trade-chart-canvas');
    if (!canvas || !ticks || ticks.length < 2) return;
    const ctx = canvas.getContext('2d'), w = canvas.width = canvas.offsetWidth, h = canvas.height = canvas.offsetHeight;
    ctx.clearRect(0, 0, w, h);
    const prices = ticks.map(t => t.price), min = Math.min(...prices), max = Math.max(...prices), range = max - min || 1, pad = 20;
    ctx.strokeStyle = 'rgba(148,163,184,0.08)'; ctx.lineWidth = 1;
    for (let i = 1; i < 5; i++) { const y = pad + (i/5)*(h-pad*2); ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(w-pad,y); ctx.stroke(); }
    const grad = ctx.createLinearGradient(0,0,0,h); grad.addColorStop(0,'rgba(16,185,129,0.15)'); grad.addColorStop(1,'rgba(16,185,129,0.01)');
    ctx.fillStyle = grad; ctx.beginPath();
    ticks.forEach((t,i) => { const x = pad+(i/(ticks.length-1))*(w-pad*2), y = h-pad-((t.price-min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.lineTo(w-pad,h-pad); ctx.lineTo(pad,h-pad); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2; ctx.beginPath();
    ticks.forEach((t,i) => { const x = pad+(i/(ticks.length-1))*(w-pad*2), y = h-pad-((t.price-min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.stroke();
  },
  drawBotChart(ticks) {
    const canvas = document.getElementById('bot-chart');
    if (!canvas || !ticks || ticks.length < 2) return;
    const ctx = canvas.getContext('2d'), w = canvas.width = canvas.offsetWidth, h = canvas.height = canvas.offsetHeight;
    ctx.clearRect(0,0,w,h);
    const prices = ticks.map(t => t.price), min = Math.min(...prices), max = Math.max(...prices), range = max - min || 1, pad = 10;
    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 1.5; ctx.beginPath();
    ticks.forEach((t,i) => { const x = pad+(i/(ticks.length-1))*(w-pad*2), y = h-pad-((t.price-min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.stroke();
  }
};

