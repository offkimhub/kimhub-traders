  },
  reset() { this.stop(); document.getElementById('bb-stack').innerHTML = ''; this.blocks = []; this.checkEmpty(); this.resetStats(); this.log('Workspace reset', 'info'); },
  executeLoop() {
    if (!this.running) return;
    const tp = this.blocks.find(b => b.type === 'trade_params');
    if (!tp) { this.log('No Trade Parameters block found', 'loss'); this.stop(); return; }
    const sym = document.getElementById(tp.id + '-sym')?.value || 'R_100';
    const type = document.getElementById(tp.id + '-type')?.value || 'CALL';
    const stake = parseFloat(document.getElementById(tp.id + '-stake')?.value) || 0.35;
