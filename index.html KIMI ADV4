  .app-sidebar { display: none; }
  .app-topbar { padding: 0 12px; }
  .app-content { padding: 12px; }
  .trade-layout { grid-template-columns: 1fr; }
  .bot-builder-layout { grid-template-columns: 1fr; grid-template-rows: auto; }
}
</style>
</head>
