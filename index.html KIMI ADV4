<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KimHubTraders | Live Deriv Trading</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
/* ═══════════════════════════════════════════════════════════════
   THEME ROOT
   ═══════════════════════════════════════════════════════════════ */
:root {
  --bg-deep: #020617;
  --bg-panel: rgba(15, 23, 42, 0.72);
  --bg-glass: rgba(15, 23, 42, 0.55);
  --border-glass: rgba(148, 163, 184, 0.08);
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --accent-green: #10b981;
  --accent-green-dim: rgba(16, 185, 129, 0.12);
  --accent-red: #ef4444;
  --accent-red-dim: rgba(239, 68, 68, 0.12);
  --accent-blue: #3b82f6;
  --accent-purple: #8b5cf6;
  --accent-orange: #f59e0b;
  --font-sans: 'Inter', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', 'IBM Plex Mono', monospace;
  --radius: 12px;
  --shadow: 0 8px 32px rgba(0,0,0,0.35);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { height: 100%; }
body {
  background: var(--bg-deep);
  color: var(--text-primary);
  font-family: var(--font-sans);
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ═══════════════════════════════════════════════════════════════
   LANDING PORTAL (PRESERVED — Dark Green KimHub Theme)
   ═══════════════════════════════════════════════════════════════ */
.entry-gate {
  position: fixed; inset: 0;
  background: #050d05;
  z-index: 99999; display: flex; flex-direction: column;
  overflow-y: auto;
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.entry-gate.hidden { opacity: 0; pointer-events: none; transform: scale(1.02); }
.lp-nav {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 2rem; border-bottom: 1px solid #1a3a1a; background: #091509;
  flex-shrink: 0;
}
.lp-logo { font-family: 'Rajdhani', sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: 2px; }
.lp-logo .k { color: #00e676; }
.lp-logo .hub { color: #c8e6c9; }
.lp-logo .trades { color: #ff6b35; }
.lp-links { display: flex; gap: 1.5rem; }
.lp-links a { color: #4a7a4a; font-size: 0.9rem; font-family: 'Exo 2', sans-serif; font-weight: 500; transition: color 0.2s; text-decoration: none; }
.lp-links a:hover { color: #00e676; }
.lp-btn-connect { background: #00e676; color: #000; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.95rem; letter-spacing: 1px; border: none; padding: 0.6rem 1.4rem; border-radius: 4px; cursor: pointer; transition: background 0.2s, transform 0.1s; }
.lp-btn-connect:hover { background: #00c853; transform: translateY(-1px); }
.lp-hero { text-align: center; padding: 5rem 2rem 4rem; }
.lp-hero-badge { display: inline-flex; align-items: center; gap: 0.4rem; background: #004d20; color: #00e676; font-family: 'DM Mono', monospace; font-size: 0.7rem; letter-spacing: 2px; padding: 0.3rem 0.9rem; border-radius: 20px; border: 1px solid #00c853; margin-bottom: 1.5rem; }
.lp-hero h1 { font-family: 'Rajdhani', sans-serif; font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 700; letter-spacing: 3px; line-height: 1; margin-bottom: 1rem; }
.lp-hero h1 .line1 { color: #c8e6c9; }
.lp-hero h1 .line2 { color: #00e676; }
.lp-hero p { font-size: 1.05rem; color: #4a7a4a; max-width: 520px; margin: 0 auto 2.5rem; line-height: 1.6; font-weight: 300; font-family: 'Exo 2', sans-serif; }
.lp-hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.lp-btn-primary { background: #00e676; color: #000; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 1rem; letter-spacing: 1px; border: none; padding: 0.8rem 2rem; border-radius: 4px; cursor: pointer; transition: background 0.2s, transform 0.1s; display: inline-flex; align-items: center; gap: 0.5rem; }
.lp-btn-primary:hover { background: #00c853; transform: translateY(-2px); }
.lp-btn-outline { background: transparent; color: #00e676; font-family: 'Rajdhani', sans-serif; font-weight: 600; font-size: 1rem; letter-spacing: 1px; border: 1px solid #00c853; padding: 0.8rem 2rem; border-radius: 4px; cursor: pointer; transition: background 0.2s, transform 0.1s; display: inline-flex; align-items: center; gap: 0.5rem; }
.lp-btn-outline:hover { background: #004d20; transform: translateY(-2px); }
.lp-stats { display: flex; justify-content: center; gap: 3rem; padding: 2rem; flex-wrap: wrap; background: #091509; border-top: 1px solid #1a3a1a; border-bottom: 1px solid #1a3a1a; }
.lp-stat { text-align: center; }
.lp-stat-num { font-family: 'Rajdhani', sans-serif; font-size: 2rem; font-weight: 700; color: #00e676; }
.lp-stat-lbl { font-size: 0.75rem; color: #4a7a4a; letter-spacing: 1px; font-family: 'DM Mono', monospace; }
.lp-features { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; padding: 3rem 2rem; max-width: 1100px; margin: 0 auto; width: 100%; }
.lp-feature { background: #0d1f0d; border: 1px solid #1a3a1a; border-radius: 8px; padding: 1.5rem; transition: border-color 0.2s, transform 0.2s; }
.lp-feature:hover { border-color: #00c853; transform: translateY(-3px); }
.lp-feature-icon { width: 48px; height: 48px; background: #004d20; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
.lp-feature-icon i { color: #00e676; font-size: 1.3rem; }
.lp-feature h3 { font-family: 'Rajdhani', sans-serif; font-size: 1.1rem; font-weight: 600; color: #69f0ae; margin-bottom: 0.5rem; }
.lp-feature p { font-size: 0.85rem; color: #4a7a4a; line-height: 1.5; font-family: 'Exo 2', sans-serif; }
.lp-footer { text-align: center; padding: 1.5rem; color: #4a7a4a; font-size: 0.75rem; font-family: 'DM Mono', monospace; border-top: 1px solid #1a3a1a; margin-top: auto; }

/* ═══════════════════════════════════════════════════════════════
   AUTH MODAL (Token Only)
   ═══════════════════════════════════════════════════════════════ */
.pat-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 99998; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
.pat-modal.active { display: flex; }
.pat-box { background: #0d1f0d; border: 1px solid #00c853; border-radius: 10px; padding: 2rem; max-width: 460px; width: 90%; position: relative; }
.pat-close { position: absolute; top: 1rem; right: 1rem; background: none; border: none; color: #4a7a4a; font-size: 1.2rem; cursor: pointer; }
.pat-close:hover { color: #00e676; }
.pat-title { font-family: 'Rajdhani', sans-serif; font-size: 1.3rem; font-weight: 700; color: #69f0ae; margin-bottom: 0.3rem; }
.pat-sub { font-size: 0.8rem; color: #4a7a4a; font-family: 'DM Mono', monospace; margin-bottom: 1.5rem; }
.pat-help { background: #091509; border: 1px solid #1a3a1a; border-radius: 6px; padding: 1rem; margin-bottom: 1.2rem; font-size: 0.78rem; color: #81c784; font-family: 'DM Mono', monospace; line-height: 1.6; }
.pat-help a { color: #00e676; font-weight: 600; }
.pat-input { width: 100%; background: #091509; border: 1px solid #224422; color: #c8e6c9; font-family: 'DM Mono', monospace; font-size: 0.85rem; padding: 0.7rem 1rem; border-radius: 4px; outline: none; margin-bottom: 0.5rem; transition: border-color 0.2s; }
.pat-input:focus { border-color: #00e676; }
.pat-btn { width: 100%; background: #00e676; color: #000; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 1rem; letter-spacing: 1px; border: none; padding: 0.7rem; border-radius: 4px; cursor: pointer; transition: background 0.2s; display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 0.5rem; }
.pat-btn:hover { background: #00c853; }
.pat-btn:disabled { opacity: 0.6; cursor: not-allowed; }
.pat-btn-secondary { width: 100%; background: #0e4c92; color: #fff; font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 1rem; letter-spacing: 1px; border: none; padding: 0.7rem; border-radius: 4px; cursor: pointer; transition: background 0.2s; display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 0.6rem; }
.pat-btn-secondary:hover { background: #0a3d7a; }
.pat-footer { font-size: 0.7rem; color: #4a7a4a; font-family: 'DM Mono', monospace; margin-top: 0.8rem; text-align: center; }
.entry-gate-error { color: #ff5252; font-size: 0.8rem; margin-bottom: 0.8rem; min-height: 1.2rem; font-weight: 600; }
.entry-gate-spinner { display: none; width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ═══════════════════════════════════════════════════════════════
   APP SHELL — Glassmorphism Dashboard
   ═══════════════════════════════════════════════════════════════ */
.app-shell { display: none; grid-template-rows: 60px 1fr; grid-template-columns: 260px 1fr; height: 100vh; background: var(--bg-deep); }
.app-shell.active { display: grid; }

/* Topbar */
.app-topbar {
  grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between;
  padding: 0 24px; background: rgba(2,6,23,0.85); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-glass); position: relative; z-index: 40;
}
.app-brand { display: flex; align-items: center; gap: 0.7rem; font-weight: 700; font-size: 1.05rem; letter-spacing: 0.5px; }
.app-brand-icon {
  width: 32px; height: 32px; border-radius: 8px;
  background: linear-gradient(135deg, var(--accent-green), #059669);
  display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.85rem;
}
.app-topbar-right { display: flex; align-items: center; gap: 0.8rem; }

.acc-pill {
  display: flex; align-items: center; gap: 0.6rem;
  background: rgba(255,255,255,0.04); border: 1px solid var(--border-glass);
  border-radius: 24px; padding: 0.35rem 0.9rem; cursor: pointer; transition: all 0.2s; position: relative;
}
.acc-pill:hover { background: rgba(255,255,255,0.08); border-color: rgba(16,185,129,0.3); }
.acc-pill-balance { font-family: var(--font-mono); font-size: 0.88rem; font-weight: 600; }
.acc-pill-badge { font-size: 0.6rem; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; }
.acc-pill-badge.demo { background: var(--accent-blue); color: #fff; }
.acc-pill-badge.real { background: var(--accent-green); color: #fff; }
.acc-pill-dropdown {
  position: absolute; top: 48px; right: 0; min-width: 320px;
  background: rgba(15,23,42,0.96); backdrop-filter: blur(16px);
  border: 1px solid var(--border-glass); border-radius: 12px; padding: 0.6rem;
  z-index: 50; box-shadow: var(--shadow); opacity: 0; pointer-events: none;
  transform: translateY(-8px); transition: all 0.2s;
}
.acc-pill-dropdown.open { opacity: 1; pointer-events: auto; transform: translateY(0); }
.acc-dropdown-item { display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 0.8rem; border-radius: 8px; cursor: pointer; transition: background 0.15s; }
.acc-dropdown-item:hover { background: rgba(255,255,255,0.05); }
.acc-dropdown-item.active { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.25); }
.acc-dd-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; color: #fff; }
.acc-dd-icon.demo { background: linear-gradient(135deg, #f59e0b, #d97706); }
.acc-dd-icon.real { background: linear-gradient(135deg, #10b981, #059669); }

/* Sidebar */
.app-sidebar {
  background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(20px);
  border-right: 1px solid var(--border-glass); display: flex; flex-direction: column; padding: 16px 10px;
}
.sidebar-nav { display: flex; flex-direction: column; gap: 0.3rem; margin-top: 0.5rem; }
.sidebar-item {
  display: flex; align-items: center; gap: 0.8rem; padding: 0.65rem 0.9rem;
  border-radius: 10px; color: var(--text-secondary); font-size: 0.85rem; font-weight: 500;
  cursor: pointer; transition: all 0.15s; border-left: 3px solid transparent;
  text-decoration: none; user-select: none;
}
.sidebar-item:hover { background: rgba(255,255,255,0.04); color: var(--text-primary); }
.sidebar-item.active { background: rgba(16,185,129,0.12); color: var(--accent-green); border-left-color: var(--accent-green); font-weight: 600; }
.sidebar-item i { width: 20px; text-align: center; font-size: 1rem; }
.sidebar-divider { height: 1px; background: var(--border-glass); margin: 0.8rem 0.6rem; }
.sidebar-section-title {
  padding: 0.6rem 0.9rem; font-size: 0.65rem; color: var(--text-muted);
  font-family: var(--font-mono); letter-spacing: 1.5px; text-transform: uppercase; font-weight: 600;
}
.sidebar-footer { margin-top: auto; padding: 0.8rem; }
.sidebar-user { display: flex; align-items: center; gap: 0.7rem; }
.user-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-green), #059669);
  display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.85rem; font-weight: 700;
}
.user-info { flex: 1; }
.user-name { font-size: 0.8rem; font-weight: 600; color: var(--text-primary); }
.user-id { font-size: 0.65rem; color: var(--text-muted); font-family: var(--font-mono); }

/* Content */
.app-content { padding: 24px; overflow-y: auto; background: radial-gradient(ellipse at top, #0b1224 0%, #020617 100%); }
.panel { display: none; animation: fadeIn 0.3s ease; }
.panel.active { display: block; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

/* Glass Cards */
.glass-card {
  background: var(--bg-glass); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-glass); border-radius: var(--radius); padding: 20px; transition: all 0.2s ease;
}
.glass-card:hover { border-color: rgba(148,163,184,0.15); }

/* Stats */
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
@media (max-width: 1200px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) { .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; } }

.stat-card { display: flex; flex-direction: column; gap: 0.4rem; }
.stat-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
.stat-value { font-family: var(--font-mono); font-size: 1.5rem; font-weight: 600; color: var(--text-primary); }
.stat-value.positive { color: var(--accent-green); }
.stat-value.negative { color: var(--accent-red); }

/* Buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.55rem 1rem; border-radius: 8px; font-family: var(--font-sans); font-weight: 600; font-size: 0.82rem; border: none; cursor: pointer; transition: all 0.15s; }
.btn-green { background: var(--accent-green); color: #fff; }
.btn-green:hover { background: #059669; transform: translateY(-1px); }
.btn-red { background: var(--accent-red); color: #fff; }
.btn-red:hover { background: #dc2626; transform: translateY(-1px); }
.btn-blue { background: var(--accent-blue); color: #fff; }
.btn-ghost { background: rgba(255,255,255,0.05); color: var(--text-secondary); border: 1px solid var(--border-glass); }
.btn-ghost:hover { background: rgba(255,255,255,0.1); color: var(--text-primary); }
.btn-sm { padding: 0.4rem 0.7rem; font-size: 0.75rem; }

/* Forms */
.form-select, .form-input {
  background: rgba(2,6,23,0.6); border: 1px solid var(--border-glass); color: var(--text-primary);
  padding: 0.5rem 0.7rem; border-radius: 8px; font-size: 0.85rem; outline: none; font-family: var(--font-sans); width: 100%; transition: border-color 0.2s;
}
.form-select:focus, .form-input:focus { border-color: var(--accent-green); }
.form-label { display: block; font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.35rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
.form-group { margin-bottom: 0.9rem; }

/* Toggle */
.toggle { position: relative; display: inline-block; width: 40px; height: 22px; }
.toggle input { opacity: 0; width: 0; height: 0; }
.toggle-slider { position: absolute; cursor: pointer; inset: 0; background: #334155; border-radius: 22px; transition: 0.3s; }
.toggle-slider:before { content:''; position:absolute; width:16px; height:16px; left:3px; bottom:3px; background:#fff; border-radius:50%; transition:0.3s; }
.toggle input:checked + .toggle-slider { background: var(--accent-green); }
.toggle input:checked + .toggle-slider:before { transform: translateX(18px); }

/* Tables */
.data-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
.data-table th { text-align: left; padding: 0.7rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.65rem; letter-spacing: 1px; border-bottom: 1px solid var(--border-glass); background: rgba(255,255,255,0.02); }
.data-table td { padding: 0.7rem; border-bottom: 1px solid var(--border-glass); color: var(--text-secondary); }
.data-table tr:hover td { background: rgba(255,255,255,0.02); color: var(--text-primary); }
.badge { font-size: 0.65rem; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
.badge-win { background: var(--accent-green-dim); color: var(--accent-green); border: 1px solid rgba(16,185,129,0.2); }
.badge-loss { background: var(--accent-red-dim); color: var(--accent-red); border: 1px solid rgba(239,68,68,0.2); }
.badge-open { background: rgba(59,130,246,0.15); color: var(--accent-blue); border: 1px solid rgba(59,130,246,0.2); }

/* Price Strip */
.price-strip { display: flex; gap: 0.8rem; overflow-x: auto; padding-bottom: 0.5rem; }
.price-chip {
  min-width: 170px; background: var(--bg-glass); border: 1px solid var(--border-glass);
  border-radius: 10px; padding: 0.8rem 1rem; display: flex; flex-direction: column; gap: 0.2rem;
  transition: all 0.2s; cursor: pointer;
}
.price-chip:hover { border-color: rgba(16,185,129,0.3); transform: translateY(-2px); }
.price-chip-symbol { font-size: 0.75rem; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 0.4rem; }
.price-chip-value { font-family: var(--font-mono); font-size: 1.1rem; font-weight: 600; }
.price-chip-change { font-size: 0.7rem; }

/* ═══════════════════════════════════════════════════════════════
   TRADE PANEL (dbtraders/wealthdbot style)
   ═══════════════════════════════════════════════════════════════ */
.trade-layout { display: grid; grid-template-columns: 1fr 380px; gap: 1.2rem; height: calc(100vh - 108px); }
@media (max-width: 1100px) { .trade-layout { grid-template-columns: 1fr; height: auto; } }

.chart-wrap {
  background: var(--bg-glass); backdrop-filter: blur(12px); border: 1px solid var(--border-glass);
  border-radius: var(--radius); padding: 1rem; display: flex; flex-direction: column; gap: 0.6rem;
}
.chart-header { display: flex; justify-content: space-between; align-items: center; }
.chart-symbol-name { font-size: 1.1rem; font-weight: 700; }
.chart-symbol-code { font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono); }
.chart-price { font-family: var(--font-mono); font-size: 1.4rem; font-weight: 600; text-align: right; }
.chart-price-change { font-size: 0.75rem; text-align: right; }
#trade-chart-canvas { width: 100%; flex: 1; min-height: 280px; background: rgba(2,6,23,0.4); border-radius: 8px; }
.tick-strip { display: flex; gap: 0.3rem; overflow-x: auto; padding: 0.3rem; min-height: 36px; align-items: center; }
.tick-pill {
  min-width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 0.7rem; font-weight: 700; font-family: var(--font-mono); flex-shrink: 0;
}

/* Order Ticket */
.order-ticket { display: flex; flex-direction: column; gap: 0.7rem; overflow-y: auto; }
.ticket-header { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.2rem; display: flex; align-items: center; gap: 0.5rem; }
.contract-tabs { display: flex; gap: 0.3rem; margin-bottom: 0.4rem; }
.contract-tab {
  flex: 1; text-align: center; padding: 0.45rem; font-size: 0.78rem; font-weight: 600;
  color: var(--text-muted); background: rgba(255,255,255,0.03); border-radius: 6px; cursor: pointer; border: 1px solid transparent;
}
.contract-tab:hover { color: var(--text-primary); background: rgba(255,255,255,0.06); }
.contract-tab.active { color: var(--accent-green); background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.3); }
.ticket-row { display: flex; gap: 0.6rem; }
.ticket-row .form-group { flex: 1; margin-bottom: 0; }
.buy-btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.3rem; }
.buy-btn {
