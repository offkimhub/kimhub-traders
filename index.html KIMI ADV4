  renderPositions() { const grid = document.getElementById('positions-grid'); document.getElementById('pos-count').textContent = `(${App.state.openContracts.length})`; if (!App.state.openContracts.length) { grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:3rem;">No open positions</div>'; return; } grid.innerHTML = App.state.openContracts.map(c => `<div class="pos-card"><div class="pos-header"><div><div class="pos-symbol">${c.symbol}</div><div class="pos-type">${c.type} • ${c.stake.toFixed(2)} ${App.state.currency}</div></div><span class="badge badge-open">OPEN</span></div><div class="pos-pl ${(c.profit||0)>=0?'positive':'negative'}" id="pos-pl-${c.id}">${(c.profit||0)>=0?'+':''}${(c.profit||0).toFixed(2)}</div><div class="pos-footer"><span class="pos-stake">#${String(c.id).slice(-6)}</span>${!App.state.isDemo ? `<button class="btn btn-red btn-sm" onclick="Trade.sell('${c.id}')">Close Now</button>` : ''}</div></div>`).join(''); },
