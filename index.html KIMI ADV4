  toggleCat(el) { const items = el.nextElementSibling; if (items) { items.classList.toggle('hidden'); el.classList.toggle('collapsed'); } },
  filterBlocks(term) { const t = term.toLowerCase(); document.querySelectorAll('.bb-block-item').forEach(item => { item.style.display = item.textContent.toLowerCase().includes(t) ? 'flex' : 'none'; }); },
  switchTab(tab, el) { document.querySelectorAll('.bb-runpanel-tab').forEach(t => t.classList.remove('active')); el.classList.add('active'); document.querySelectorAll('.bb-runpanel-content').forEach(c => c.style.display = 'none'); document.getElementById('bb-panel-' + tab).style.display = 'block'; },
  addBlock(type) {
