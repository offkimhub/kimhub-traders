}
.pos-header { display: flex; justify-content: space-between; align-items: center; }
.pos-symbol { font-weight: 700; font-size: 0.9rem; }
.pos-type { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
.pos-pl { font-family: var(--font-mono); font-size: 1.3rem; font-weight: 600; }
.pos-pl.positive { color: var(--accent-green); }
.pos-pl.negative { color: var(--accent-red); }
.pos-footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--border-glass); }
.pos-stake { font-size: 0.75rem; color: var(--text-muted); }

/* Notification */
.notif {
  position: fixed; bottom: 1.5rem; right: 1.5rem;
  background: var(--bg-glass); backdrop-filter: blur(12px); border: 1px solid var(--border-glass);
  border-radius: 10px; padding: 0.8rem 1.2rem; display: flex; align-items: center; gap: 0.7rem;
