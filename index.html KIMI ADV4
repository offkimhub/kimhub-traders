<script>
/* ═══════════════════════════════════════════════════════════════
   CORE STATE
   ═══════════════════════════════════════════════════════════════ */
const APP_ID = 1089;
const WS_URL = `wss://ws.binaryws.com/websockets/v3?app_id=${APP_ID}`;

const App = {
  state: {
    authenticated: false, isDemo: false, token: null,
    balance: 0, currency: 'USD', loginid: '', email: '', fullname: 'Trader', isVirtual: true,
    todayPnl: 0, wins: 0, losses: 0, openContracts: [], history: [], savedAccounts: [], soundEnabled: true
  }
};

/* ═══════════════════════════════════════════════════════════════
   WEBSOCKET
   ═══════════════════════════════════════════════════════════════ */
const WS = {
  socket: null, connected: false, listeners: {}, queue: [],
  connect() {
    if (this.socket && (this.socket.readyState === WebSocket.CONNECTING || this.socket.readyState === WebSocket.OPEN)) return;
    this.socket = new WebSocket(WS_URL);
    this.socket.onopen = () => {
      this.connected = true;
      while (this.queue.length) this.send(this.queue.shift());
      if (App.state.token) this.send({ authorize: App.state.token });
      else if (App.state.isDemo) Markets.loadAll();
    };
    this.socket.onmessage = (e) => this.handle(JSON.parse(e.data));
    this.socket.onclose = () => { this.connected = false; setTimeout(() => this.connect(), 3000); };
  },
  send(msg) { if (!this.connected || !this.socket || this.socket.readyState !== WebSocket.OPEN) { this.queue.push(msg); return; } this.socket.send(JSON.stringify(msg)); },
  on(event, cb) { if (!this.listeners[event]) this.listeners[event] = []; this.listeners[event].push(cb); },
  handle(data) {
    if (data.error) { UI.notify(data.error.message, 'error'); return; }
    const type = Object.keys(data).find(k => !['echo_req','req_id','subscription'].includes(k));
    if (this.listeners[type]) this.listeners[type].forEach(cb => cb(data[type], data));
  }
};

/* ═══════════════════════════════════════════════════════════════
   AUTHENTICATION (Token Only)
   ═══════════════════════════════════════════════════════════════ */
const Auth = {
  init() { const saved = localStorage.getItem('kht_accounts'); if (saved) App.state.savedAccounts = JSON.parse(saved); this.renderSaved(); },
  showModal() { document.getElementById('auth-modal').classList.add('active'); document.getElementById('auth-token-input').focus(); },
  hideModal() { document.getElementById('auth-modal').classList.remove('active'); document.getElementById('auth-error').textContent = ''; },
  login() {
    const token = document.getElementById('auth-token-input').value.trim();
    if (!token) { document.getElementById('auth-error').textContent = 'Enter a valid API token'; return; }
    this.setLoading(true);
    App.state.token = token; App.state.isDemo = false;
    WS.connect(); setTimeout(() => WS.send({ authorize: token }), 500);
    setTimeout(() => { if (!App.state.authenticated) { this.setLoading(false); document.getElementById('auth-error').textContent = 'Connection timeout.'; } }, 6000);
  },
  setLoading(v) {
    document.getElementById('auth-btn').disabled = v;
    document.getElementById('auth-spinner').style.display = v ? 'block' : 'none';
    document.getElementById('auth-btn-text').textContent = v ? 'Connecting...' : 'Connect Account';
    document.getElementById('auth-btn-icon').style.display = v ? 'none' : 'inline-block';
  },
  enterDemo() {
    App.state.isDemo = true; App.state.authenticated = true; App.state.balance = 10000; App.state.currency = 'USD';
    App.state.loginid = 'VRTC-DEMO'; App.state.isVirtual = true; App.state.fullname = 'Demo Trader';
    this.hideModal(); document.getElementById('entry-gate').classList.add('hidden'); UI.showApp(); UI.updateAccount();
    Markets.loadAll(); WS.connect(); UI.notify('Demo mode active. Trades simulated with real market data.');
  },
  logout() {
    App.state.authenticated = false; App.state.isDemo = false; App.state.token = null; App.state.balance = 0;
    App.state.openContracts = []; App.state.history = []; App.state.todayPnl = 0; App.state.wins = 0; App.state.losses = 0;
    if (WS.socket) WS.socket.close();
    document.getElementById('app-shell').classList.remove('active'); document.getElementById('entry-gate').classList.remove('hidden');
    UI.updateAccount(); UI.renderPositions(); UI.renderHistory(); UI.renderDashboard(); BotBuilder.stop();
  },
  saveAccount(token, auth) {
    const exists = App.state.savedAccounts.find(a => a.token === token);
    if (!exists) { App.state.savedAccounts.push({ token, loginid: auth.loginid, currency: auth.currency, isVirtual: auth.is_virtual, name: auth.fullname || auth.email || 'Account' }); localStorage.setItem('kht_accounts', JSON.stringify(App.state.savedAccounts)); this.renderSaved(); }
  },
  renderSaved() {
    const wrap = document.getElementById('saved-accounts-wrap'), list = document.getElementById('saved-accounts-list');
    if (!App.state.savedAccounts.length) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'block';
    list.innerHTML = App.state.savedAccounts.map(a => `
      <div style="display:flex;align-items:center;justify-content:space-between;background:#091509;border:1px solid #1a3a1a;border-radius:6px;padding:0.5rem 0.7rem;margin-bottom:0.4rem;cursor:pointer;" onclick="Auth.useSaved('${a.token}')">
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <div style="width:28px;height:28px;border-radius:50%;background:${a.isVirtual?'linear-gradient(135deg,#f59e0b,#d97706)':'linear-gradient(135deg,#10b981,#059669)'};display:flex;align-items:center;justify-content:center;color:#fff;font-size:0.7rem;font-weight:700;">${a.name.charAt(0).toUpperCase()}</div>
          <div><div style="font-size:0.78rem;font-weight:600;color:#c8e6c9;">${a.name}</div><div style="font-size:0.65rem;color:#4a7a4a;font-family:monospace;">${a.loginid}</div></div>
        </div>
        <button onclick="event.stopPropagation();Auth.removeSaved('${a.token}')" style="background:none;border:none;color:#4a7a4a;cursor:pointer;font-size:0.8rem;"><i class="fas fa-times"></i></button>
      </div>
    `).join('');
  },
  useSaved(token) { document.getElementById('auth-token-input').value = token; this.login(); },
  removeSaved(token) { App.state.savedAccounts = App.state.savedAccounts.filter(a => a.token !== token); localStorage.setItem('kht_accounts', JSON.stringify(App.state.savedAccounts)); this.renderSaved(); },
  toggleDropdown() { document.getElementById('acc-dropdown').classList.toggle('open'); }
};

WS.on('authorize', (auth) => {
  App.state.authenticated = true; App.state.currency = auth.currency || 'USD'; App.state.loginid = auth.loginid;
  App.state.isVirtual = auth.is_virtual; App.state.balance = auth.balance; App.state.email = auth.email;
  App.state.fullname = auth.fullname || auth.email || 'Trader'; Auth.saveAccount(App.state.token, auth);
  Auth.hideModal(); document.getElementById('entry-gate').classList.add('hidden'); UI.showApp(); UI.updateAccount();
  WS.send({ balance: 1, subscribe: 1 }); WS.send({ transaction: 1, subscribe: 1 }); WS.send({ account_list: 1 });
  Markets.loadAll(); UI.notify(`Authorized as ${auth.loginid}`);
});

WS.on('balance', (bal) => { App.state.balance = parseFloat(bal.balance); UI.updateBalance(); });

WS.on('account_list', (list) => {
  const container = document.getElementById('acc-dropdown-accounts');
  if (!list || !list.length || !container) return;
  container.innerHTML = list.map(acc => {
    const isActive = acc.loginid === App.state.loginid;
    return `<div class="acc-dropdown-item ${isActive ? 'active' : ''}" onclick="${isActive ? '' : `UI.notify('Please logout and connect with token for ${acc.loginid}')`}; Auth.toggleDropdown();">
      <div class="acc-dd-icon ${acc.is_virtual ? 'demo' : 'real'}">${acc.currency.charAt(0)}</div>
      <div style="flex:1;"><div style="font-size:0.8rem;font-weight:600;">${acc.loginid}</div><div style="font-size:0.65rem;color:var(--text-muted);">${acc.currency} ${acc.is_virtual ? '• Demo' : '• Real'}</div></div>
      ${isActive ? '<i class="fas fa-check" style="color:var(--accent-green);font-size:0.7rem;"></i>' : ''}
    </div>`;
  }).join('');
});

/* ═══════════════════════════════════════════════════════════════
   MARKETS
   ═══════════════════════════════════════════════════════════════ */
const Markets = {
  symbols: [], categories: {}, activeSymbol: 'R_100', ticks: {}, tickHistory: {},
  loadAll() { WS.send({ active_symbols: 'brief', product_type: 'basic' }); },
  handleSymbols(data) {
    this.symbols = (data.active_symbols || []).filter(s => s.exchange_is_open !== 0);
    this.categories = {};
    const catMap = { synthetic_index: { name: 'Derived Indices', icon: 'fa-bolt' }, forex: { name: 'Forex', icon: 'fa-exchange-alt' }, indices: { name: 'Stock Indices', icon: 'fa-chart-bar' }, commodities: { name: 'Commodities', icon: 'fa-coins' } };
    this.symbols.forEach(s => { const key = s.market; if (!this.categories[key]) this.categories[key] = { ...catMap[key], items: [] }; this.categories[key].items.push(s); });
    this.populateSelects(); UI.renderMarkets(); this.subscribe(this.activeSymbol);
  },
  populateSelects() {
    const opts = Object.values(this.categories).map(c => `<optgroup label="${c.name}">${c.items.map(s => `<option value="${s.symbol}" ${s.symbol===this.activeSymbol?'selected':''}>${s.display_name}</option>`).join('')}</optgroup>`).join('');
    ['ticket-symbol', 'quick-symbol'].forEach(id => { const el = document.getElementById(id); if (el) el.innerHTML = opts; });
  },
  subscribe(symbol) {
    if (!symbol) return; this.activeSymbol = symbol;
    WS.send({ forget_all: 'ticks' }); WS.send({ ticks: symbol, subscribe: 1 });
    WS.send({ ticks_history: symbol, adjust_start_time: 1, count: 100, end: 'latest', start: 1, style: 'ticks' });
  },
  handleTick(tick) {
    if (!tick || !tick.quote) return;
    const sym = tick.symbol, price = tick.quote, prev = this.ticks[sym] ? this.ticks[sym].price : price;
    this.ticks[sym] = { price, epoch: tick.epoch, prev };
    if (!this.tickHistory[sym]) this.tickHistory[sym] = [];
    this.tickHistory[sym].push({ price, epoch: tick.epoch });
    if (this.tickHistory[sym].length > 300) this.tickHistory[sym].shift();
    if (sym === this.activeSymbol) {
      document.getElementById('trade-price').textContent = price.toFixed(tick.pip_size || 2);
      const change = price - prev;
      document.getElementById('trade-change').innerHTML = `<span style="color:${change>=0?'var(--accent-green)':'var(--accent-red)'}">${change>=0?'+':''}${change.toFixed(tick.pip_size||2)}</span>`;
      const strip = document.getElementById('trade-tick-strip');
      const digit = Math.floor(price * Math.pow(10, tick.pip_size||2)) % 10;
      const node = document.createElement('div');
      node.className = 'tick-pill'; node.style.cssText = `background:${digit%2===0?'rgba(16,185,129,0.15)':'rgba(239,68,68,0.15)'};color:${digit%2===0?'var(--accent-green)':'var(--accent-red)'};`;
      node.textContent = digit; strip.appendChild(node);
      if (strip.children.length > 30) strip.removeChild(strip.firstChild); strip.scrollLeft = strip.scrollWidth;
      Charts.drawTradeChart(this.tickHistory[sym]);
      document.getElementById('bb-chart-symbol').textContent = sym;
      Charts.drawBotChart(this.tickHistory[sym]);
    }
    UI.updatePriceChip(sym, price, prev);
  },
  filter(term) { const t = term.toLowerCase(); document.querySelectorAll('.market-item').forEach(el => { el.style.display = el.textContent.toLowerCase().includes(t) ? 'flex' : 'none'; }); }
};

WS.on('active_symbols', (d) => Markets.handleSymbols(d));
WS.on('tick', (d) => Markets.handleTick(d));
WS.on('history', (d) => { if (d && d.prices && d.times) { const sym = d.echo_req.ticks_history; Markets.tickHistory[sym] = d.prices.map((p,i) => ({ price: p, epoch: d.times[i] })); if (sym === Markets.activeSymbol) { Charts.drawTradeChart(Markets.tickHistory[sym]); Charts.drawBotChart(Markets.tickHistory[sym]); } } });

/* ═══════════════════════════════════════════════════════════════
   TRADE ENGINE
   ═══════════════════════════════════════════════════════════════ */
const Trade = {
  currentProposal: null, pendingDirection: null, martingaleStake: 1.00,
  onSymbolChange() { const sym = document.getElementById('ticket-symbol').value; Markets.subscribe(sym); const s = Markets.symbols.find(x => x.symbol === sym); document.getElementById('trade-symbol-name').textContent = s ? s.display_name : sym; document.getElementById('trade-symbol-code').textContent = sym; document.getElementById('quick-symbol').value = sym; },
