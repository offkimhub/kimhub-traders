  },
  checkEmpty() { const stack = document.getElementById('bb-stack'); if (!stack.children.length) stack.innerHTML = `<div style="text-align:center;color:var(--text-muted);padding:3rem 1rem;"><i class="fas fa-cubes" style="font-size:2.5rem;margin-bottom:1rem;display:block;opacity:0.3;"></i><p style="font-size:0.85rem;">Your strategy workspace is empty.</p><p style="font-size:0.75rem;margin-top:0.5rem;">Click blocks from the toolbox to build your bot.</p><button class="btn btn-green btn-sm" style="margin-top:1rem;" onclick="BotBuilder.loadQuick('martingale')"><i class="fas fa-magic"></i> Load Quick Strategy</button></div>`; },
  loadQuick(strategy) {
    document.getElementById('bb-stack').innerHTML = '';
