const Trade = {
  currentProposal: null, pendingDirection: null, martingaleStake: 1.00,
  onSymbolChange() { const sym = document.getElementById('ticket-symbol').value; Markets.subscribe(sym); const s = Markets.symbols.find(x => x.symbol === sym); document.getElementById('trade-symbol-name').textContent = s ? s.display_name : sym; document.getElementById('trade-symbol-code').textContent = sym; document.getElementById('quick-symbol').value = sym; },
  setCat(cat, el) { document.querySelectorAll('.contract-tab').forEach(t => t.classList.remove('active')); el.classList.add('active'); document.getElementById('ticket-options').style.display = cat === 'options' ? 'block' : 'none'; document.getElementById('ticket-multipliers').style.display = cat === 'multipliers' ? 'block' : 'none'; },
  quick(dir) { document.getElementById('ticket-symbol').value = document.getElementById('quick-symbol').value; document.getElementById('ticket-contract-type').value = document.getElementById('quick-type').value; document.getElementById('ticket-duration').value = document.getElementById('quick-dur').value; document.getElementById('ticket-duration-unit').value = document.getElementById('quick-dur-unit').value; document.getElementById('ticket-stake').value = document.getElementById('quick-stake').value; this.execute(dir); },
  execute(direction) {
    if (!App.state.authenticated) { UI.notify('Connect or enter demo mode first'); return; }
    const isMultiplier = document.getElementById('ticket-multipliers').style.display !== 'none';
    const symbol = document.getElementById('ticket-symbol').value;
    const duration = parseInt(document.getElementById('ticket-duration').value) || 1;
    const durationUnit = document.getElementById('ticket-duration-unit').value;
    const stake = parseFloat(document.getElementById('ticket-stake').value) || 0.35;
    let contractType, barrier;
    if (isMultiplier) { contractType = document.getElementById('ticket-multiplier-type').value; }
    else {
      contractType = document.getElementById('ticket-contract-type').value;
      if (contractType === 'DIGITOVER' || contractType === 'DIGITUNDER') barrier = document.getElementById('ticket-barrier').value;
    }
    if (direction === 'up' && !isMultiplier) { if (contractType === 'CALL' || contractType === 'PUT') contractType = 'CALL'; }
    else if (direction === 'down' && !isMultiplier) { if (contractType === 'CALL' || contractType === 'PUT') contractType = 'PUT'; }
    const req = { proposal: 1, amount: stake, basis: 'stake', contract_type: contractType, currency: App.state.currency, duration: duration, duration_unit: durationUnit, symbol: symbol };
    if (barrier !== undefined && barrier !== '') req.barrier = barrier;
    this.pendingDirection = direction; this.currentProposal = null; WS.send(req); UI.notify('Requesting proposal...');
  },
  handleProposal(proposal) {
    if (!proposal || !proposal.id) { UI.notify('Proposal failed'); return; }
    this.currentProposal = proposal;
    const payout = ((proposal.payout / proposal.ask_price - 1) * 100).toFixed(1);
    if (this.pendingDirection === 'up') document.getElementById('ticket-payout-up').textContent = '+' + payout + '%';
    else if (this.pendingDirection === 'down') document.getElementById('ticket-payout-down').textContent = '+' + payout + '%';
    if (App.state.isDemo) { this.simulateContract(proposal); return; }
    WS.send({ buy: proposal.id, price: proposal.ask_price });
  },
  handleBuy(buy) {
    if (!buy || !buy.contract_id) { UI.notify('Purchase failed'); return; }
    const contract = { id: buy.contract_id, symbol: buy.symbol || Markets.activeSymbol, type: buy.contract_type || this.currentProposal?.contract_type || 'Unknown', stake: parseFloat(buy.buy_price || this.currentProposal?.ask_price || 0), entryPrice: Markets.ticks[Markets.activeSymbol]?.price || 0, entryTime: Date.now(), status: 'OPEN', longcode: buy.longcode || '' };
    App.state.openContracts.push(contract);
    WS.send({ proposal_open_contract: 1, contract_id: buy.contract_id, subscribe: 1 });
    UI.renderPositions(); UI.updateDashboard(); UI.notify(`Contract #${buy.contract_id} purchased`); if (App.state.soundEnabled) Audio.play('buy');
  },
  handleContractUpdate(poc) {
    const c = App.state.openContracts.find(x => x.id === poc.contract_id);
    if (!c) return;
    c.profit = parseFloat(poc.profit || 0); c.exitPrice = poc.exit_tick_display_value ? parseFloat(poc.exit_tick_display_value) : c.exitPrice; c.status = (poc.is_expired || poc.is_sold) ? 'CLOSED' : 'OPEN';
    if (c.status === 'CLOSED') {
      App.state.openContracts = App.state.openContracts.filter(x => x.id !== c.id);
      App.state.todayPnl += c.profit; App.state.history.unshift({ time: new Date().toLocaleString(), id: c.id, symbol: c.symbol, type: c.type, stake: c.stake, entry: c.entryPrice, exit: c.exitPrice || 0, profit: c.profit, status: c.profit >= 0 ? 'WON' : 'LOST' });
      if (c.profit >= 0) App.state.wins++; else App.state.losses++;
      UI.renderPositions(); UI.renderHistory(); UI.renderDashboard();
      UI.notify(`${c.profit >= 0 ? 'WIN' : 'LOSS'}: ${c.profit >= 0 ? '+' : ''}${c.profit.toFixed(2)} ${App.state.currency}`);
      if (App.state.soundEnabled) Audio.play(c.profit >= 0 ? 'win' : 'loss');
      const martingale = document.getElementById('ticket-martingale').checked;
      if (martingale) { const stakeInput = document.getElementById('ticket-stake'); if (c.profit < 0) { this.martingaleStake = parseFloat((c.stake * 2).toFixed(2)); stakeInput.value = this.martingaleStake; UI.notify(`Martingale: stake doubled to ${this.martingaleStake}`); } else { this.martingaleStake = parseFloat(stakeInput.getAttribute('data-base') || stakeInput.value); stakeInput.value = this.martingaleStake; } }
    } else {
      const plEl = document.getElementById(`pos-pl-${c.id}`);
      if (plEl) { plEl.textContent = (c.profit >= 0 ? '+' : '') + c.profit.toFixed(2); plEl.className = 'pos-pl ' + (c.profit >= 0 ? 'positive' : 'negative'); }
    }
  },
  simulateContract(proposal) {
    const cfg = { symbol: proposal.echo_req.symbol, contract_type: proposal.echo_req.contract_type, duration: proposal.echo_req.duration, duration_unit: proposal.echo_req.duration_unit, barrier: proposal.echo_req.barrier, stake: proposal.echo_req.amount };
    const entryPrice = Markets.ticks[cfg.symbol]?.price || 0;
    const fakeId = 'DEMO-' + Date.now();
    const contract = { id: fakeId, symbol: cfg.symbol, type: cfg.contract_type, stake: cfg.stake, entryPrice, entryTime: Date.now(), status: 'OPEN', profit: 0, longcode: `[DEMO] ${cfg.contract_type} ${cfg.symbol}` };
    App.state.openContracts.push(contract); UI.renderPositions(); UI.notify('[DEMO] Contract opened');
    const resolveDelay = cfg.duration_unit === 't' ? cfg.duration * 1500 : cfg.duration * 1000 * (cfg.duration_unit === 'm' ? 60 : cfg.duration_unit === 'h' ? 3600 : 1);
    setTimeout(() => {
      const hist = Markets.tickHistory[cfg.symbol]; const exitTick = hist && hist.length > 0 ? hist[hist.length - 1] : { price: entryPrice }; const exitPrice = exitTick.price;
      let isWin = false;
      if (cfg.contract_type === 'CALL') isWin = exitPrice > entryPrice;
      else if (cfg.contract_type === 'PUT') isWin = exitPrice < entryPrice;
      else if (cfg.contract_type === 'DIGITOVER') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d > parseInt(cfg.barrier || 5); }
      else if (cfg.contract_type === 'DIGITUNDER') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d < parseInt(cfg.barrier || 5); }
      else if (cfg.contract_type === 'DIGITEVEN') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d % 2 === 0; }
      else if (cfg.contract_type === 'DIGITODD') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d % 2 === 1; }
      else { isWin = Math.random() > 0.45; }
      const profit = isWin ? (cfg.stake * 0.88) : -cfg.stake;
      contract.profit = profit; contract.exitPrice = exitPrice; contract.status = 'CLOSED';
      App.state.openContracts = App.state.openContracts.filter(x => x.id !== fakeId);
      App.state.todayPnl += profit; App.state.history.unshift({ time: new Date().toLocaleString(), id: fakeId, symbol: cfg.symbol, type: cfg.contract_type, stake: cfg.stake, entry: entryPrice, exit: exitPrice, profit, status: isWin ? 'WON' : 'LOST' });
      if (isWin) App.state.wins++; else App.state.losses++;
      UI.renderPositions(); UI.renderHistory(); UI.renderDashboard();
      UI.notify(`[DEMO] ${isWin ? 'WIN' : 'LOSS'} ${profit >= 0 ? '+' : ''}${profit.toFixed(2)}`);
      if (App.state.soundEnabled) Audio.play(isWin ? 'win' : 'loss');
    }, Math.min(resolveDelay, 5000));
  },
  sell(contractId) { if (App.state.isDemo) { UI.notify('Cannot sell in demo mode'); return; } WS.send({ sell: contractId }); }
};

WS.on('proposal', (d) => Trade.handleProposal(d));
WS.on('buy', (d) => Trade.handleBuy(d));
