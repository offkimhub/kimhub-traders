const Markets = {
  symbols: [], categories: {}, activeSymbol: 'R_100',
  ticks: {}, tickHistory: {},
  loadAll() { WS.send({ active_symbols: 'brief', product_type: 'basic' }); },
  handleSymbols(data) {
    this.symbols = (data.active_symbols || []).filter(s => s.exchange_is_open !== 0);
    this.categories = {};
    const catMap = {
      synthetic_index: { name: 'Derived Indices', icon: 'fa-bolt' },
      forex: { name: 'Forex', icon: 'fa-exchange-alt' },
      indices: { name: 'Stock Indices', icon: 'fa-chart-bar' },
      commodities: { name: 'Commodities', icon: 'fa-coins' }
    };
    this.symbols.forEach(s => {
      const key = s.market;
      if (!this.categories[key]) this.categories[key] = { ...catMap[key], items: [] };
      this.categories[key].items.push(s);
    });
    this.populateSelects();
    UI.renderMarkets();
    this.subscribe(this.activeSymbol);
  },
  populateSelects() {
    const opts = Object.values(this.categories).map(c =>
      `<optgroup label="${c.name}">${c.items.map(s => `<option value="${s.symbol}" ${s.symbol===this.activeSymbol?'selected':''}>${s.display_name}</option>`).join('')}</optgroup>`
    ).join('');
    ['ticket-symbol', 'quick-symbol', 'analysis-market'].forEach(id => {
      const el = document.getElementById(id); if (el) el.innerHTML = opts;
    });
  },
  subscribe(symbol) {
    if (!symbol) return; this.activeSymbol = symbol;
    WS.send({ forget_all: 'ticks' });
    WS.send({ ticks: symbol, subscribe: 1 });
    WS.send({ ticks_history: symbol, adjust_start_time: 1, count: 100, end: 'latest', start: 1, style: 'ticks' });
  },
  handleTick(tick) {
    if (!tick || !tick.quote) return;
    const sym = tick.symbol, price = tick.quote;
    const prev = this.ticks[sym] ? this.ticks[sym].price : price;
    this.ticks[sym] = { price, epoch: tick.epoch, prev };
    if (!this.tickHistory[sym]) this.tickHistory[sym] = [];
    this.tickHistory[sym].push({ price, epoch: tick.epoch });
    if (this.tickHistory[sym].length > App.config.tickBufferSize) this.tickHistory[sym].shift();

    if (sym === this.activeSymbol) {
      document.getElementById('trade-price').textContent = price.toFixed(tick.pip_size || 2);
      const change = price - prev;
      document.getElementById('trade-change').innerHTML = `<span style="color:${change>=0?'var(--accent-green)':'var(--accent-red)'}">${change>=0?'+':''}${change.toFixed(tick.pip_size||2)}</span>`;

      const strip = document.getElementById('trade-tick-strip');
      const digit = Math.floor(price * Math.pow(10, tick.pip_size||2)) % 10;
      const node = document.createElement('div');
      node.className = 'tick-pill';
      node.style.cssText = `background:${digit%2===0?'rgba(16,185,129,0.15)':'rgba(239,68,68,0.15)'};color:${digit%2===0?'var(--accent-green)':'var(--accent-red)'};`;
      node.textContent = digit;
      strip.appendChild(node);
      if (strip.children.length > 30) strip.removeChild(strip.firstChild);
      strip.scrollLeft = strip.scrollWidth;

      Charts.drawTradeChart(this.tickHistory[sym]);
      document.getElementById('bb-chart-symbol').textContent = sym;
      Charts.drawBotChart(this.tickHistory[sym]);
      Indicators.calculate(sym);
    }
    UI.updatePriceChip(sym, price, prev);
  },
  filter(term) {
    const t = term.toLowerCase();
    document.querySelectorAll('.market-item').forEach(el => {
      el.style.display = el.textContent.toLowerCase().includes(t) ? 'flex' : 'none';
    });
  }
};

WS.on('active_symbols', (d) => Markets.handleSymbols(d));
WS.on('tick', (d) => Markets.handleTick(d));
WS.on('history', (d) => {
  if (d && d.prices && d.times) {
    const sym = d.echo_req.ticks_history;
    Markets.tickHistory[sym] = d.prices.map((p,i) => ({ price: p, epoch: d.times[i] }));
