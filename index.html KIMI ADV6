/* ═══════════════════════════════════════════════════════════════
   DIGIT FREQUENCY ANALYZER
   ═══════════════════════════════════════════════════════════════ */
const Analyzer = {
  tickWindow: 1000,
  recentDigit: null,
  timer: null,
  
  init() {
    this.renderGrid();
    document.getElementById('analysis-ticks-input').addEventListener('change', (e) => {
      this.tickWindow = Math.max(50, Math.min(5000, parseInt(e.target.value) || 1000));
      e.target.value = this.tickWindow;
    });
    document.getElementById('analysis-market').addEventListener('change', (e) => {
      Markets.subscribe(e.target.value);
    });
  },
  
  renderGrid() {
    const grid = document.getElementById('digit-grid');
    grid.innerHTML = '';
    for (let i = 0; i <= 9; i++) {
      const card = document.createElement('div');
      card.className = 'digit-card';
      card.dataset.digit = i;
      card.innerHTML = `<span class="digit-num">${i}</span><span class="digit-pct">0%</span>`;
      grid.appendChild(card);
    }
  },
  
  generateTickData(count) {
    return Array.from({length: count}, () => {
      const base = 6000 + Math.random() * 2000;
      const price = parseFloat(base.toFixed(2));
      return { price, epoch: Date.now() - Math.floor(Math.random() * 100000) };
    });
  },
  
  getLastDigit(price) {
    const clean = String(price).replace('.', '').replace('-', '');
    return parseInt(clean.slice(-1), 10);
  },
  
  analyzeDigits(ticks) {
    if (!ticks || !ticks.length) return;
    const digits = ticks.map(t => this.getLastDigit(t.price));
    const counts = new Array(10).fill(0);
    digits.forEach(d => { if (d >= 0 && d <= 9) counts[d]++; });
    const total = digits.length;
    
    counts.forEach((count, i) => {
      const pct = total > 0 ? ((count / total) * 100).toFixed(1) : '0.0';
      const card = document.querySelector(`.digit-card[data-digit="${i}"]`);
      if (card) {
        card.querySelector('.digit-pct').textContent = pct + '%';
        card.classList.remove('highest', 'lowest', 'recent');
      }
    });
    
    let maxCount = -1, minCount = Infinity, maxIdx = -1, minIdx = -1;
    counts.forEach((c, i) => {
      if (c > maxCount) { maxCount = c; maxIdx = i; }
      if (c < minCount) { minCount = c; minIdx = i; }
    });
    
    if (maxIdx >= 0) {
      const maxCard = document.querySelector(`.digit-card[data-digit="${maxIdx}"]`);
      if (maxCard) maxCard.classList.add('highest');
    }
    if (minIdx >= 0 && minIdx !== maxIdx) {
      const minCard = document.querySelector(`.digit-card[data-digit="${minIdx}"]`);
      if (minCard) minCard.classList.add('lowest');
    }
    
    const recent = digits[digits.length - 1];
    this.recentDigit = recent;
    const recentCard = document.querySelector(`.digit-card[data-digit="${recent}"]`);
    if (recentCard) recentCard.classList.add('recent');
    
    const evenCount = digits.filter(d => d % 2 === 0).length;
    const oddCount = total - evenCount;
    const overCount = digits.filter(d => d > 5).length;
    const underCount = digits.filter(d => d < 5).length;
    
    const evenPct = ((evenCount / total) * 100).toFixed(1);
    const oddPct = ((oddCount / total) * 100).toFixed(1);
    const overPct = ((overCount / total) * 100).toFixed(1);
    const underPct = ((underCount / total) * 100).toFixed(1);
    
    document.getElementById('analysis-summary').innerHTML = `
      <div><strong>Even/Odd:</strong> Even: ${evenPct}% | Odd: ${oddPct}%</div>
      <div><strong>Over/Under 5:</strong> Over 5: ${overPct}% | Under 5: ${underPct}%</div>
      <div style="margin-top:0.5rem;color:var(--text-muted);font-size:0.75rem;">Based on last ${total} ticks</div>
    `;
  },
  
  start() {
    if (this.timer) clearInterval(this.timer);
    this.timer = setInterval(() => {
      const sym = Markets.activeSymbol || 'R_100';
      const hist = Markets.tickHistory[sym];
      if (hist && hist.length >= 10) {
        const slice = hist.slice(-this.tickWindow);
        this.analyzeDigits(slice);
      } else {
        this.analyzeDigits(this.generateTickData(this.tickWindow));
      }
    }, 2000);
    UI.notify('Digit analysis started');
  },
  
  stop() {
    if (this.timer) clearInterval(this.timer);
    UI.notify('Digit analysis stopped');
  }
};

/* ═══════════════════════════════════════════════════════════════
   CHARTS
   ═══════════════════════════════════════════════════════════════ */
const Charts = {
  drawTradeChart(ticks) {
    const canvas = document.getElementById('trade-chart-canvas');
    if (!canvas || !ticks || ticks.length < 2) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width = canvas.offsetWidth;
    const h = canvas.height = canvas.offsetHeight;
    ctx.clearRect(0, 0, w, h);
    const prices = ticks.map(t => t.price);
    const min = Math.min(...prices), max = Math.max(...prices);
    const range = max - min || 1;
    const pad = 30;
    ctx.strokeStyle = 'rgba(148,163,184,0.06)'; ctx.lineWidth = 1;
    for (let i = 1; i < 5; i++) { const y = pad + (i/5)*(h-pad*2); ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(w-pad,y); ctx.stroke(); }
    ctx.fillStyle = 'var(--text-muted)'; ctx.font = '10px JetBrains Mono'; ctx.textAlign = 'right';
    for (let i = 0; i < 5; i++) { const price = min + (range * (4-i) / 4); const y = pad + (i/4)*(h-pad*2); ctx.fillText(price.toFixed(4), pad - 5, y + 3); }
    const grad = ctx.createLinearGradient(0, 0, 0, h);
    grad.addColorStop(0, 'rgba(16,185,129,0.15)'); grad.addColorStop(1, 'rgba(16,185,129,0.01)');
    ctx.fillStyle = grad; ctx.beginPath();
    ticks.forEach((t, i) => { const x = pad + (i/(ticks.length-1))*(w-pad*2), y = h - pad - ((t.price - min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.lineTo(w-pad, h-pad); ctx.lineTo(pad, h-pad); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 2; ctx.beginPath();
    ticks.forEach((t, i) => { const x = pad + (i/(ticks.length-1))*(w-pad*2), y = h - pad - ((t.price - min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.stroke();
    if (Indicators.active.has('ma') && Indicators.data.ma.length) {
      const maData = Indicators.data.ma;
      const offset = prices.length - maData.length;
      ctx.strokeStyle = 'rgba(59,130,246,0.8)'; ctx.lineWidth = 1.5; ctx.beginPath();
      maData.forEach((v, i) => { const x = pad + ((i+offset)/(ticks.length-1))*(w-pad*2), y = h - pad - ((v - min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
      ctx.stroke();
    }
    if (Indicators.active.has('bb') && Indicators.data.bb.length) {
      const bbData = Indicators.data.bb;
      const offset = prices.length - bbData.length;
      ctx.strokeStyle = 'rgba(139,92,246,0.5)'; ctx.setLineDash([4,4]); ctx.lineWidth = 1;
      ['upper', 'lower'].forEach(band => {
        ctx.beginPath();
        bbData.forEach((v, i) => { const x = pad + ((i+offset)/(ticks.length-1))*(w-pad*2), y = h - pad - ((v[band] - min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
        ctx.stroke();
      });
      ctx.setLineDash([]);
    }
  },
  drawBotChart(ticks) {
    const canvas = document.getElementById('bot-chart');
    if (!canvas || !ticks || ticks.length < 2) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width = canvas.offsetWidth;
    const h = canvas.height = canvas.offsetHeight;
    ctx.clearRect(0, 0, w, h);
    const prices = ticks.map(t => t.price);
    const min = Math.min(...prices), max = Math.max(...prices);
    const range = max - min || 1;
    const pad = 10;
    ctx.strokeStyle = '#10b981'; ctx.lineWidth = 1.5; ctx.beginPath();
    ticks.forEach((t, i) => { const x = pad + (i/(ticks.length-1))*(w-pad*2), y = h - pad - ((t.price - min)/range)*(h-pad*2); if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
    ctx.stroke();
  }
};

