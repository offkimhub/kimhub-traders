<script>
/* ═══════════════════════════════════════════════════════════════
   KIMHUB TRADERS - FULLY FUNCTIONAL FRONTEND
   Enhanced with: Backend API integration, AI Assistant, Google Drive,
   Multipliers/Accumulators, Technical Indicators, Bot Persistence,
   Blockly Workspace, Digit Analyzer, Responsive Light/Dark Themes,
   WebSocket Heartbeat & Auto-Reconnect
   ═══════════════════════════════════════════════════════════════ */

const API_BASE = localStorage.getItem('kht_api_base') || 'http://localhost:5000/api';
const APP_ID = 1089;
const WS_URL = `wss://ws.binaryws.com/websockets/v3?app_id=${APP_ID}`;

const App = {
  state: {
    authenticated: false, isDemo: false, token: null, jwtToken: null,
    balance: 0, currency: 'USD', loginid: '', email: '', fullname: 'Trader', isVirtual: true,
    todayPnl: 0, wins: 0, losses: 0, openContracts: [], history: [],
    savedAccounts: [], soundEnabled: true, autoSync: false,
    gdriveConnected: false, gdriveRefreshToken: null,
    currentBotId: null, historyPage: 1, historyLimit: 20,
    _intentionalClose: false
  },
  config: {
    apiBase: API_BASE,
    wsReconnectInterval: 3000,
    tickBufferSize: 300,
    maxHistoryPerPage: 50
  }
};

/* ═══════════════════════════════════════════════════════════════
   THEME MANAGER
   ═══════════════════════════════════════════════════════════════ */
const Theme = {
  init() {
    const saved = localStorage.getItem('kht_theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    const toggle = document.getElementById('drawer-theme-toggle');
    if (toggle) toggle.checked = saved === 'dark';
  },
  toggle() {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('kht_theme', next);
    const toggle = document.getElementById('drawer-theme-toggle');
    if (toggle) toggle.checked = next === 'dark';
  }
};

/* ═══════════════════════════════════════════════════════════════
   SIDE MENU CONTROLLER
   ═══════════════════════════════════════════════════════════════ */
const SideMenu = {
  toggle() {
    const menu = document.getElementById('side-menu');
    const backdrop = document.querySelector('.drawer-backdrop');
    menu.classList.toggle('is-open');
    backdrop.classList.toggle('is-open');
  }
};

/* ═══════════════════════════════════════════════════════════════
   BACKEND API CLIENT
   ═══════════════════════════════════════════════════════════════ */
const API = {
  async request(endpoint, options = {}) {
    const url = `${App.config.apiBase}${endpoint}`;
    const headers = {
      'Content-Type': 'application/json',
      ...options.headers
    };
    if (App.state.jwtToken) {
      headers['Authorization'] = `Bearer ${App.state.jwtToken}`;
    }
    try {
      const res = await fetch(url, {
        method: options.method || 'GET',
        headers,
        body: options.body ? JSON.stringify(options.body) : undefined
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      return data;
    } catch (err) {
      console.error('API Error:', err);
      throw err;
    }
  },
  // Auth
  register: (email, password, fullName) => API.request('/auth/register', { method: 'POST', body: { email, password, fullName } }),
  login: (email, password) => API.request('/auth/login', { method: 'POST', body: { email, password } }),
  connectDeriv: (token, email, password, loginid, currency, isVirtual, name) => 
    API.request('/auth/deriv', { method: 'POST', body: { token, email, password, loginid, currency, isVirtual, name } }),

  // Bots
  getBots: (params = '') => API.request(`/bots?${params}`),
  getBot: (id) => API.request(`/bots/${id}`),
  createBot: (data) => API.request('/bots', { method: 'POST', body: data }),
  updateBot: (id, data) => API.request(`/bots/${id}`, { method: 'PUT', body: data }),
  renameBot: (id, name) => API.request(`/bots/${id}/rename`, { method: 'PATCH', body: { name } }),
  cloneBot: (id) => API.request(`/bots/${id}/clone`, { method: 'POST' }),
  deleteBot: (id) => API.request(`/bots/${id}`, { method: 'DELETE' }),
  importBot: (format, data, name) => API.request('/bots/import', { method: 'POST', body: { format, data, name } }),
  exportBotXML: (id) => `${App.config.apiBase}/bots/${id}/export/xml`,
  exportBotJSON: (id) => `${App.config.apiBase}/bots/${id}/export/json`,

  // History
  storeTransaction: (data) => API.request('/history', { method: 'POST', body: data }),
  bulkStoreTransactions: (transactions) => API.request('/history/bulk', { method: 'POST', body: { transactions } }),
  getHistory: (params = '') => API.request(`/history?${params}`),
  getStats: () => API.request('/history/stats'),
  exportCSV: () => `${App.config.apiBase}/history/export/csv`,

  // Upload / Google Drive
  uploadBotFile: (formData) => {
    return fetch(`${App.config.apiBase}/upload/bot`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${App.state.jwtToken}` },
      body: formData
    }).then(r => r.json());
  },
  getDriveAuthUrl: () => API.request('/upload/drive/auth'),
  uploadToDrive: (data) => API.request('/upload/drive/upload', { method: 'POST', body: data }),
  listDriveFiles: (refreshToken) => API.request(`/upload/drive/files?refreshToken=${encodeURIComponent(refreshToken)}`),
  downloadDriveFile: (fileId, refreshToken) => API.request(`/upload/drive/file/${fileId}?refreshToken=${encodeURIComponent(refreshToken)}`),

  // AI
  chatAI: (messages, model) => API.request('/ai/chat', { method: 'POST', body: { messages, model } }),
  analyzeStrategy: (strategy, stats) => API.request('/ai/analyze-strategy', { method: 'POST', body: { strategy, stats } })
};

/* ═══════════════════════════════════════════════════════════════
   WEBSOCKET (with Heartbeat, Ping/Pong, Auto-Reconnect)
   ═══════════════════════════════════════════════════════════════ */
const WS = {
  socket: null, connected: false, listeners: {}, queue: [], reconnectAttempts: 0,
  heartbeatInterval: null, pongTimeout: null,

  connect() {
    if (this.socket && (this.socket.readyState === WebSocket.CONNECTING || this.socket.readyState === WebSocket.OPEN)) return;
    try {
      this.socket = new WebSocket(WS_URL);
      this.socket.onopen = () => {
        this.connected = true; this.reconnectAttempts = 0;
        this.startHeartbeat();
        while (this.queue.length) this.send(this.queue.shift());
        if (App.state.token) {
          this.send({ authorize: App.state.token });
        } else if (App.state.isDemo) {
          Markets.loadAll();
        }
      };
      this.socket.onmessage = (e) => {
        let data;
        try { data = JSON.parse(e.data); } catch(err) { return; }
        if (data.msg_type === 'ping' || data.ping) {
          this.send({ pong: 1 });
          return;
        }
        this.handle(data);
      };
      this.socket.onclose = () => {
        this.connected = false; this.stopHeartbeat();
        if (!App.state._intentionalClose) {
          this.reconnectAttempts++;
          const delay = Math.min(3000 * Math.pow(2, this.reconnectAttempts - 1), 30000);
          setTimeout(() => this.connect(), delay);
        }
      };
      this.socket.onerror = (err) => {
        console.error('WS Error:', err);
        this.socket.close();
      };
    } catch(e) {
      console.error('WS Connect Error:', e);
      this.reconnectAttempts++;
      setTimeout(() => this.connect(), 5000);
    }
  },

  startHeartbeat() {
    this.stopHeartbeat();
    this.heartbeatInterval = setInterval(() => {
      if (this.connected && this.socket && this.socket.readyState === WebSocket.OPEN) {
        this.send({ ping: 1 });
        this.pongTimeout = setTimeout(() => {
          console.warn('Heartbeat timeout, forcing reconnect');
          this.socket.close();
        }, 10000);
      }
    }, 30000);
  },

  stopHeartbeat() {
    if (this.heartbeatInterval) { clearInterval(this.heartbeatInterval); this.heartbeatInterval = null; }
    if (this.pongTimeout) { clearTimeout(this.pongTimeout); this.pongTimeout = null; }
  },

  send(msg) {
    if (!this.connected || !this.socket || this.socket.readyState !== WebSocket.OPEN) {
      this.queue.push(msg);
      return false;
    }
    try {
      this.socket.send(JSON.stringify(msg));
      return true;
    } catch(e) {
      console.error('WS Send Error:', e);
      this.queue.push(msg);
      return false;
    }
  },

  on(event, cb) { if (!this.listeners[event]) this.listeners[event] = []; this.listeners[event].push(cb); },
  off(event, cb) {
    if (!this.listeners[event]) return;
    this.listeners[event] = this.listeners[event].filter(fn => fn !== cb);
  },

  handle(data) {
    if (data.error) {
      const code = data.error.code;
      const msg = data.error.message;
      if (code === 'AuthorizationRequired') { UI.notify('Session expired. Please log in again.', 'error'); Auth.logout(); return; }
      if (code === 'InvalidToken') { UI.notify('Invalid API token. Please check and reconnect.', 'error'); localStorage.removeItem('kht_last_token'); return; }
      if (code === 'MarketIsClosed') { UI.notify('Market is currently closed.', 'error'); return; }
      if (code === 'InsufficientFunds') { UI.notify('Insufficient funds for this trade.', 'error'); return; }
      UI.notify(msg || 'API Error', 'error');
      return;
    }
    const type = data.msg_type || Object.keys(data).find(k => !['echo_req','req_id','subscription'].includes(k));
    if (type === 'pong') {
      if (this.pongTimeout) { clearTimeout(this.pongTimeout); this.pongTimeout = null; }
      return;
    }
    if (this.listeners[type]) {
      this.listeners[type].forEach(cb => {
        try { cb(data[type] || data, data); } catch(e) { console.error('Handler error:', e); }
      });
    }
  },

  disconnect() {
    App.state._intentionalClose = true;
    this.stopHeartbeat();
    if (this.socket) { this.socket.close(); this.socket = null; }
    this.connected = false;
  }
};

/* ═══════════════════════════════════════════════════════════════
   AUTHENTICATION (Token + Email/Password + Backend + Persistence)
   ═══════════════════════════════════════════════════════════════ */
const Auth = {
  init() {
    const saved = localStorage.getItem('kht_accounts');
    if (saved) App.state.savedAccounts = JSON.parse(saved);
    
    const lastToken = localStorage.getItem('kht_last_token');
    const lastDemo = localStorage.getItem('kht_demo_mode');
    const jwt = localStorage.getItem('kht_jwt');
    
    if (jwt) {
      App.state.jwtToken = jwt;
      this.validateSession().catch(() => {});
    }
    
    if (lastToken && !App.state.authenticated) {
      App.state.token = lastToken;
      App.state.isDemo = false;
      WS.connect();
    } else if (lastDemo === 'true' && !App.state.authenticated) {
      this.enterDemo();
    }
    
    this.renderSaved();
  },

  async validateSession() {
    try { await API.getStats(); } catch (err) {
      App.state.jwtToken = null; localStorage.removeItem('kht_jwt');
    }
  },

  switchTab(tab) {
    document.getElementById('auth-panel-token').style.display = tab === 'token' ? 'block' : 'none';
    document.getElementById('auth-panel-email').style.display = tab === 'email' ? 'block' : 'none';
    document.getElementById('auth-btn').style.display = tab === 'token' ? 'flex' : 'none';
    document.getElementById('auth-tab-token').style.borderColor = tab === 'token' ? 'var(--accent-green)' : '';
    document.getElementById('auth-tab-email').style.borderColor = tab === 'email' ? 'var(--accent-green)' : '';
  },

  showModal() { document.getElementById('auth-modal').classList.add('active'); document.getElementById('auth-token-input').focus(); },
  hideModal() { document.getElementById('auth-modal').classList.remove('active'); document.getElementById('auth-error').textContent = ''; },

  async loginEmail() {
    const email = document.getElementById('auth-email-input').value.trim();
    const password = document.getElementById('auth-password-input').value;
    if (!email || !password) { document.getElementById('auth-error').textContent = 'Email and password required'; return; }
    this.setLoading(true);
    try {
      const res = await API.login(email, password);
      App.state.jwtToken = res.token;
      localStorage.setItem('kht_jwt', res.token);
      App.state.email = res.user.email;
      App.state.fullname = res.user.fullName;
      this.hideModal(); document.getElementById('entry-gate').classList.add('hidden');
      UI.showApp(); UI.updateAccount(); UI.notify('Welcome back, ' + res.user.fullName);
    } catch (err) { document.getElementById('auth-error').textContent = err.message; }
    finally { this.setLoading(false); }
  },

  async registerEmail() {
    const email = document.getElementById('auth-email-input').value.trim();
    const password = document.getElementById('auth-password-input').value;
    if (!email || !password) { document.getElementById('auth-error').textContent = 'Email and password required'; return; }
    if (password.length < 6) { document.getElementById('auth-error').textContent = 'Password must be at least 6 characters'; return; }
    this.setLoading(true);
    try {
      const res = await API.register(email, password);
      App.state.jwtToken = res.token;
      localStorage.setItem('kht_jwt', res.token);
      App.state.email = res.user.email;
      App.state.fullname = res.user.fullName;
      this.hideModal(); document.getElementById('entry-gate').classList.add('hidden');
      UI.showApp(); UI.updateAccount(); UI.notify('Account created successfully');
    } catch (err) { document.getElementById('auth-error').textContent = err.message; }
    finally { this.setLoading(false); }
  },

  login() {
    const token = document.getElementById('auth-token-input').value.trim();
    if (!token) { document.getElementById('auth-error').textContent = 'Enter a valid API token'; return; }
    this.setLoading(true);
    App.state.token = token; App.state.isDemo = false;
    localStorage.setItem('kht_last_token', token);
    localStorage.removeItem('kht_demo_mode');
    WS.connect();
    setTimeout(() => WS.send({ authorize: token }), 500);
    setTimeout(() => {
      if (!App.state.authenticated) {
        this.setLoading(false);
        document.getElementById('auth-error').textContent = 'Connection timeout. Check your token.';
      }
    }, 8000);
  },

  setLoading(v) {
    document.getElementById('auth-btn').disabled = v;
    document.getElementById('auth-spinner').style.display = v ? 'block' : 'none';
    document.getElementById('auth-btn-text').textContent = v ? 'Connecting...' : 'Connect Account';
    document.getElementById('auth-btn-icon').style.display = v ? 'none' : 'inline-block';
  },

  enterDemo() {
    App.state.isDemo = true; App.state.authenticated = true;
    App.state.balance = 10000; App.state.currency = 'USD';
    App.state.loginid = 'VRTC-DEMO'; App.state.isVirtual = true;
    App.state.fullname = 'Demo Trader';
    localStorage.setItem('kht_demo_mode', 'true');
    localStorage.removeItem('kht_last_token');
    this.hideModal(); document.getElementById('entry-gate').classList.add('hidden');
    UI.showApp(); UI.updateAccount();
    WS.connect();
    UI.notify('Demo mode active. Trades simulated with real market data.');
  },

  logout() {
    App.state.authenticated = false; App.state.isDemo = false;
    App.state.token = null; App.state.jwtToken = null;
    App.state.balance = 0; App.state.openContracts = [];
    App.state.history = []; App.state.todayPnl = 0;
    App.state.wins = 0; App.state.losses = 0;
    localStorage.removeItem('kht_jwt');
    localStorage.removeItem('kht_last_token');
    localStorage.removeItem('kht_demo_mode');
    WS.disconnect();
    document.getElementById('app-shell').classList.remove('active');
    document.getElementById('entry-gate').classList.remove('hidden');
    UI.updateAccount(); UI.renderPositions(); UI.renderHistory();
    UI.renderDashboard(); BotBuilder.stop();
    AIAssistant.close();
  },

  saveAccount(token, auth) {
    const exists = App.state.savedAccounts.find(a => a.token === token);
    if (!exists) {
      App.state.savedAccounts.push({
        token, loginid: auth.loginid, currency: auth.currency,
        isVirtual: auth.is_virtual, name: auth.fullname || auth.email || 'Account'
      });
      localStorage.setItem('kht_accounts', JSON.stringify(App.state.savedAccounts));
      this.renderSaved();
    }
  },

  renderSaved() {
    const wrap = document.getElementById('saved-accounts-wrap');
    const list = document.getElementById('saved-accounts-list');
    if (!App.state.savedAccounts.length) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'block';
    list.innerHTML = App.state.savedAccounts.map(a => `
