    });
    
    // Init Blockly when botbuilder panel opens
    if (name === 'botbuilder' && typeof Blockly !== 'undefined' && !BlocklyWorkspace.workspace) {
      setTimeout(() => BlocklyWorkspace.init(), 100);
    }
    // Init Analyzer when analysis panel opens
    if (name === 'analysis' && !Analyzer.timer) {
      Analyzer.start();
    }
  },
  
  switchTab(btn) {
    const tabName = btn.dataset.tab;
    document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
