    const recent = App.state.history.slice(0, 5);
    if (!recent.length) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:1.5rem;">No trades yet</td></tr>'; }
    else { tbody.innerHTML = recent.map(t => `<tr><td>${t.time.split(',')[1] || t.time}</td><td style="font-family:var(--font-mono);font-size:0.75rem;">${String(t.id).slice(-8)}</td><td>${t.type}</td><td>${t.stake.toFixed(2)}</td><td><span class="badge ${t.status==='WON'?'badge-win':'badge-loss'}">${t.status}</span></td><td style="color:${t.profit>=0?'var(--accent-green)':'var(--accent-red)'};font-weight:600;">${t.profit>=0?'+':''}${t.profit.toFixed(2)}</td></tr>`).join(''); }
  },
  renderPositions() {
    const grid = document.getElementById('positions-grid');
    document.getElementById('pos-count').textContent = `(${App.state.openContracts.length})`;
    if (!App.state.openContracts.length) { grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:3rem;">No open positions</div>'; return; }
    grid.innerHTML = App.state.openContracts.map(c => `<div class="pos-card"><div class="pos-header"><div><div class="pos-symbol">${c.symbol}</div><div class="pos-type">${c.type} • ${c.stake.toFixed(2)} ${App.state.currency}</div></div><span class="badge badge-open">OPEN</span></div><div class="pos-pl ${(c.profit||0)>=0?'positive':'negative'}" id="pos-pl-${c.id}">${(c.profit||0)>=0?'+':''}${(c.profit||0).toFixed(2)}</div><div class="pos-footer"><span class="pos-stake">#${String(c.id).slice(-6)}</span>${!App.state.isDemo ? `<button class="btn btn-red btn-sm" onclick="Trade.sell('${c.id}')">Close Now</button>` : ''}</div></div>`).join('');
  },
  renderHistory() {
    const tbody = document.getElementById('history-tbody');
    if (!App.state.history.length) { tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:2rem;">No closed trades yet</td></tr>'; return; }
    tbody.innerHTML = App.state.history.map(h => `<tr><td style="font-size:0.75rem;">${h.time}</td><td style="font-family:var(--font-mono);font-size:0.75rem;">${String(h.id).slice(-8)}</td><td>${h.symbol}</td><td>${h.type}</td><td>${h.stake.toFixed(2)}</td><td style="font-family:var(--font-mono);">${h.entry ? h.entry.toFixed(4) : '--'}</td><td style="font-family:var(--font-mono);">${h.exit ? h.exit.toFixed(4) : '--'}</td><td style="color:${h.profit>=0?'var(--accent-green)':'var(--accent-red)'};font-weight:600;">${h.profit>=0?'+':''}${h.profit.toFixed(2)}</td><td><span class="badge ${h.status==='WON'?'badge-win':'badge-loss'}">${h.status}</span></td></tr>`).join('');
  },
  renderMarkets() {
    const container = document.getElementById('markets-container');
    const catMap = { synthetic_index: { name: 'Derived Indices', icon: 'fa-bolt' }, forex: { name: 'Forex', icon: 'fa-exchange-alt' }, indices: { name: 'Stock Indices', icon: 'fa-chart-bar' }, commodities: { name: 'Commodities', icon: 'fa-coins' } };
    container.innerHTML = Object.keys(Markets.categories).map(key => {
      const cat = Markets.categories[key];
      const info = catMap[key] || { name: key.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()), icon: 'fa-circle' };
      return `<div class="market-cat"><div class="market-cat-title"><i class="fas ${info.icon}" style="color:var(--accent-green);"></i> ${info.name}</div><div class="market-grid">${cat.items.map(s => `<div class="market-item ${Markets.activeSymbol===s.symbol?'active':''}" onclick="Markets.subscribe('${s.symbol}');UI.switchPanel('trade', document.querySelectorAll('.sidebar-item')[1]);"><div><div class="market-name">${s.display_name}</div><div class="market-code">${s.symbol}</div></div><i class="fas fa-chart-line" style="color:var(--text-muted);font-size:0.8rem;"></i></div>`).join('')}</div></div>`;
    }).join('');
  },
  updatePriceChip(sym, price, prev) {
    const strip = document.getElementById('dash-price-strip');
    if (!strip) return;
    let chip = document.getElementById('chip-' + sym);
    const change = price - prev;
    const pct = prev ? ((change / prev) * 100).toFixed(3) : '0.000';
    const color = change >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';
    if (!chip) { chip = document.createElement('div'); chip.className = 'price-chip'; chip.id = 'chip-' + sym; strip.appendChild(chip); }
    const s = Markets.symbols.find(x => x.symbol === sym);
    chip.innerHTML = `<div class="price-chip-symbol"><i class="fas ${change>=0?'fa-arrow-up':'fa-arrow-down'}" style="color:${color};font-size:0.65rem;"></i> ${s ? s.display_name : sym}</div><div class="price-chip-value" style="color:${color};">${price.toFixed(4)}</div><div class="price-chip-change" style="color:${color};">${change>=0?'+':''}${change.toFixed(4)} (${pct}%)</div>`;
  },
  notify(msg, type = 'success') {
    const n = document.getElementById('notif');
    const icon = n.querySelector('i');
    icon.className = type === 'error' ? 'fas fa-exclamation-circle' : 'fas fa-check-circle';
    icon.style.color = type === 'error' ? 'var(--accent-red)' : 'var(--accent-green)';
    document.getElementById('notif-text').textContent = msg;
    n.classList.add('show');
    setTimeout(() => n.classList.remove('show'), 3500);
  }
};

/* ═══════════════════════════════════════════════════════════════
   HISTORY & SETTINGS
   ═══════════════════════════════════════════════════════════════ */
const History = {
  exportCSV() {
    if (!App.state.history.length) { UI.notify('No history to export'); return; }
    const rows = App.state.history.map(h => [h.time, h.id, h.symbol, h.type, h.stake, h.entry, h.exit, h.profit, h.status]);
    const csv = [['Time','ID','Symbol','Type','Stake','Entry','Exit','P&L','Status'], ...rows].map(r => r.map(c => `"${c}"`).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `kimhub_history_${new Date().toISOString().slice(0,10)}.csv`; a.click();
    URL.revokeObjectURL(url);
    UI.notify('History exported to CSV');
  },
  async syncBackend() {
    if (!App.state.jwtToken) { UI.notify('Please log in to sync'); return; }
    if (!App.state.history.length) { UI.notify('No history to sync'); return; }
    try {
      const txs = App.state.history.map(h => ({
        contractId: String(h.id), symbol: h.symbol, type: h.type, category: h.category || 'options',
        stake: h.stake, currency: App.state.currency,
        entryPrice: h.entry || 0, exitPrice: h.exit || 0,
        profit: h.profit, status: h.status,
        entryTime: new Date(h.time || Date.now()).toISOString(), isVirtual: App.state.isVirtual
      }));
      const res = await API.bulkStoreTransactions(txs);
      UI.notify(`Synced ${res.inserted} transactions to cloud`);
    } catch (err) { UI.notify('Sync failed: ' + err.message, 'error'); }
  },
  prevPage() { if (App.state.historyPage > 1) { App.state.historyPage--; this.loadBackendPage(); } },
  nextPage() { App.state.historyPage++; this.loadBackendPage(); },
  async loadBackendPage() {
    if (!App.state.jwtToken) return;
    try {
      const res = await API.getHistory(`page=${App.state.historyPage}&limit=${App.state.historyLimit}`);
      document.getElementById('history-page').textContent = `Page ${App.state.historyPage} of ${res.pages || 1}`;
      if (res.transactions && res.transactions.length) {
        App.state.history = res.transactions.map(t => ({
          time: new Date(t.entryTime).toLocaleString(), id: t.contractId, symbol: t.symbol,
          type: t.type, category: t.category, stake: t.stake,
          entry: t.entryPrice, exit: t.exitPrice, profit: t.profit, status: t.status
        }));
        UI.renderHistory();
      }
    } catch (err) { console.error('History load failed:', err); }
  }
};

const Settings = {
  toggleSound() { App.state.soundEnabled = document.getElementById('setting-sound').checked; UI.notify(App.state.soundEnabled ? 'Sound ON' : 'Sound OFF'); },
  toggleAutoSync() { App.state.autoSync = document.getElementById('setting-autosync').checked; UI.notify(App.state.autoSync ? 'Auto-sync ON' : 'Auto-sync OFF'); }
};

/* ═══════════════════════════════════════════════════════════════
   AUDIO
   ═══════════════════════════════════════════════════════════════ */
const Audio = {
  ctx: null,
  init() { if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)(); },
  play(type) {
    if (!App.state.soundEnabled) return;
    this.init();
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.connect(gain); gain.connect(this.ctx.destination);
    const now = this.ctx.currentTime;
    if (type === 'win') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(523, now);
      osc.frequency.setValueAtTime(659, now + 0.1);
      osc.frequency.setValueAtTime(784, now + 0.2);
      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
      osc.start(now); osc.stop(now + 0.4);
    } else if (type === 'loss') {
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(300, now);
      osc.frequency.exponentialRampToValueAtTime(100, now + 0.3);
      gain.gain.setValueAtTime(0.1, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
      osc.start(now); osc.stop(now + 0.3);
    } else if (type === 'buy') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, now);
      osc.frequency.setValueAtTime(554, now + 0.08);
      gain.gain.setValueAtTime(0.1, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
      osc.start(now); osc.stop(now + 0.2);
    }
  }
};

/* ═══════════════════════════════════════════════════════════════
   INIT
   ═══════════════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {
  Theme.init();
  Auth.init();
  Analyzer.init();

  // Check for Google Drive callback
  const urlParams = new URLSearchParams(window.location.search);
  const gdriveToken = urlParams.get('gdrive');
  const driveToken = urlParams.get('token');
  if (gdriveToken === 'connected' && driveToken) {
    App.state.gdriveConnected = true;
    App.state.gdriveRefreshToken = driveToken;
    localStorage.setItem('kht_gdrive_token', driveToken);
    document.getElementById('gdrive-status').textContent = 'Connected';
    document.getElementById('gdrive-status').style.color = 'var(--accent-green)';
    document.getElementById('btn-gdrive-connect').innerHTML = '<i class="fab fa-google-drive"></i> Connected';
    window.history.replaceState({}, document.title, window.location.pathname);
  } else {
    const savedDrive = localStorage.getItem('kht_gdrive_token');
    if (savedDrive) {
      App.state.gdriveConnected = true;
      App.state.gdriveRefreshToken = savedDrive;
      document.getElementById('gdrive-status').textContent = 'Connected (saved)';
      document.getElementById('gdrive-status').style.color = 'var(--accent-green)';
      document.getElementById('btn-gdrive-connect').innerHTML = '<i class="fab fa-google-drive"></i> Connected';
    }
  }

  document.addEventListener('click', (e) => {
    const pill = document.querySelector('.acc-pill');
    const dropdown = document.getElementById('acc-dropdown');
    if (pill && dropdown && !pill.contains(e.target)) dropdown.classList.remove('open');
  });

  document.getElementById('ticket-contract-type').addEventListener('change', (e) => {
    const show = ['DIGITOVER','DIGITUNDER','DIGITMATCH','DIGITDIFF'].includes(e.target.value);
    document.getElementById('ticket-barrier-wrap').style.display = show ? 'block' : 'none';
  });

  const stakeInput = document.getElementById('ticket-stake');
  stakeInput.setAttribute('data-base', stakeInput.value);
  stakeInput.addEventListener('change', (e) => {
    if (!Trade.martingaleStake || Trade.martingaleStake === parseFloat(e.target.getAttribute('data-base'))) {
      e.target.setAttribute('data-base', e.target.value);
    }
  });

  document.getElementById('auth-token-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') Auth.login(); });
  document.getElementById('ai-input').addEventListener('keypress', (e) => { if (e.key === 'Enter') AIAssistant.send(); });

  window.addEventListener('resize', () => {
    if (Markets.tickHistory[Markets.activeSymbol]) {
      Charts.drawTradeChart(Markets.tickHistory[Markets.activeSymbol]);
      Charts.drawBotChart(Markets.tickHistory[Markets.activeSymbol]);
    }
  });
});
