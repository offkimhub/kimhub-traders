});

/* ═══════════════════════════════════════════════════════════════
   TECHNICAL INDICATORS
   ═══════════════════════════════════════════════════════════════ */
const Indicators = {
  active: new Set(),
  data: { rsi: [], ma: [], bb: [], macd: [] },
  toggle(name) {
    const chip = document.getElementById('ind-' + name);
    if (this.active.has(name)) {
      this.active.delete(name); chip.classList.remove('active');
    } else {
      this.active.add(name); chip.classList.add('active');
    }
    if (Markets.tickHistory[Markets.activeSymbol]) {
      Charts.drawTradeChart(Markets.tickHistory[Markets.activeSymbol]);
    }
  },
  calculate(symbol) {
    const ticks = Markets.tickHistory[symbol];
    if (!ticks || ticks.length < 20) return;
    const prices = ticks.map(t => t.price);
    if (this.active.has('rsi')) this.data.rsi = this.calcRSI(prices, 14);
    if (this.active.has('ma')) this.data.ma = this.calcMA(prices, 20);
    if (this.active.has('bb')) this.data.bb = this.calcBollinger(prices, 20, 2);
    if (this.active.has('macd')) this.data.macd = this.calcMACD(prices);
  },
  calcRSI(prices, period) {
    const rsi = [];
    let gains = 0, losses = 0;
    for (let i = 1; i <= period; i++) {
      const diff = prices[i] - prices[i-1];
      if (diff > 0) gains += diff; else losses -= diff;
    }
    let avgGain = gains / period, avgLoss = losses / period;
    for (let i = period; i < prices.length; i++) {
      const diff = prices[i] - prices[i-1];
      avgGain = (avgGain * (period - 1) + (diff > 0 ? diff : 0)) / period;
      avgLoss = (avgLoss * (period - 1) + (diff < 0 ? -diff : 0)) / period;
      const rs = avgLoss === 0 ? 100 : avgGain / avgLoss;
      rsi.push(100 - (100 / (1 + rs)));
    }
    return rsi;
  },
  calcMA(prices, period) {
    const ma = [];
    for (let i = period - 1; i < prices.length; i++) {
      const sum = prices.slice(i - period + 1, i + 1).reduce((a,b) => a+b, 0);
      ma.push(sum / period);
    }
    return ma;
  },
  calcBollinger(prices, period, stdDev) {
    const bb = [];
    for (let i = period - 1; i < prices.length; i++) {
      const slice = prices.slice(i - period + 1, i + 1);
      const mean = slice.reduce((a,b) => a+b, 0) / period;
      const variance = slice.reduce((a,b) => a + Math.pow(b - mean, 2), 0) / period;
      const sd = Math.sqrt(variance);
      bb.push({ upper: mean + stdDev * sd, middle: mean, lower: mean - stdDev * sd });
    }
    return bb;
  },
  calcMACD(prices) {
    const ema = (data, period) => {
      const k = 2 / (period + 1);
      const emaArr = [data[0]];
      for (let i = 1; i < data.length; i++) emaArr.push(data[i] * k + emaArr[i-1] * (1 - k));
      return emaArr;
    };
    const ema12 = ema(prices, 12);
    const ema26 = ema(prices, 26);
    const macdLine = ema12.slice(25).map((v,i) => v - ema26[i + 25 - 12 + 1]);
    const signal = ema(macdLine, 9);
    return macdLine.map((v,i) => ({ macd: v, signal: signal[i] || 0, histogram: v - (signal[i] || 0) }));
  }
};

/* ═══════════════════════════════════════════════════════════════
   TRADE ENGINE (Options + Multipliers + Accumulators)
   ═══════════════════════════════════════════════════════════════ */
const Trade = {
  currentProposal: null, pendingDirection: null, martingaleStake: 1.00,
  currentCategory: 'options',

  onSymbolChange() {
    const sym = document.getElementById('ticket-symbol').value;
    Markets.subscribe(sym);
    const s = Markets.symbols.find(x => x.symbol === sym);
    document.getElementById('trade-symbol-name').textContent = s ? s.display_name : sym;
    document.getElementById('trade-symbol-code').textContent = sym;
    document.getElementById('quick-symbol').value = sym;
  },

  setCat(cat, el) {
    this.currentCategory = cat;
    document.querySelectorAll('.contract-tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('ticket-options').style.display = cat === 'options' ? 'block' : 'none';
    document.getElementById('ticket-multipliers').style.display = cat === 'multipliers' ? 'block' : 'none';
    document.getElementById('ticket-accumulators').style.display = cat === 'accumulators' ? 'block' : 'none';
    const upBtn = document.getElementById('btn-buy-up');
    const downBtn = document.getElementById('btn-buy-down');
    if (cat === 'multipliers') {
      upBtn.innerHTML = '<i class="fas fa-arrow-up"></i> Buy Up <span class="payout" id="ticket-payout-up">--</span>';
      downBtn.innerHTML = '<i class="fas fa-arrow-down"></i> Buy Down <span class="payout" id="ticket-payout-down">--</span>';
      downBtn.style.display = 'flex';
    } else if (cat === 'accumulators') {
      upBtn.innerHTML = '<i class="fas fa-plus"></i> Start <span class="payout" id="ticket-payout-up">--</span>';
      downBtn.style.display = 'none';
    } else {
      upBtn.innerHTML = '<i class="fas fa-arrow-up"></i> Buy <span class="payout" id="ticket-payout-up">--%</span>';
      downBtn.innerHTML = '<i class="fas fa-arrow-down"></i> Sell <span class="payout" id="ticket-payout-down">--%</span>';
      downBtn.style.display = 'flex';
    }
  },

  quick(dir) {
    document.getElementById('ticket-symbol').value = document.getElementById('quick-symbol').value;
    document.getElementById('ticket-contract-type').value = document.getElementById('quick-type').value;
    document.getElementById('ticket-duration').value = document.getElementById('quick-dur').value;
    document.getElementById('ticket-duration-unit').value = document.getElementById('quick-dur-unit').value;
    document.getElementById('ticket-stake').value = document.getElementById('quick-stake').value;
    this.execute(dir);
  },

  execute(direction) {
    if (!App.state.authenticated) { UI.notify('Connect or enter demo mode first'); return; }
    const symbol = document.getElementById('ticket-symbol').value;
    const duration = parseInt(document.getElementById('ticket-duration').value) || 1;
    const durationUnit = document.getElementById('ticket-duration-unit').value;
    const stake = parseFloat(document.getElementById('ticket-stake').value) || 0.35;

    let req = { proposal: 1, amount: stake, basis: 'stake', currency: App.state.currency, duration, duration_unit: durationUnit, symbol };

    if (this.currentCategory === 'multipliers') {
      const multType = document.getElementById('ticket-multiplier-type').value;
      const multiplier = parseInt(document.getElementById('ticket-multiplier').value);
      const tp = parseFloat(document.getElementById('ticket-multiplier-tp').value);
      const sl = parseFloat(document.getElementById('ticket-multiplier-sl').value);
      req.contract_type = multType;
      req.multiplier = multiplier;
      req.take_profit = tp;
      req.stop_loss = sl;
      delete req.duration; delete req.duration_unit;
    } else if (this.currentCategory === 'accumulators') {
      const growthRate = parseFloat(document.getElementById('ticket-growth-rate').value);
      const tp = parseFloat(document.getElementById('ticket-accum-tp').value);
      req.contract_type = 'ACCU';
      req.growth_rate = growthRate;
      req.take_profit = tp;
      delete req.duration; delete req.duration_unit;
    } else {
      let contractType = document.getElementById('ticket-contract-type').value;
      if (direction === 'up' && (contractType === 'CALL' || contractType === 'PUT')) contractType = 'CALL';
      else if (direction === 'down' && (contractType === 'CALL' || contractType === 'PUT')) contractType = 'PUT';
      req.contract_type = contractType;
      if (['DIGITOVER','DIGITUNDER','DIGITMATCH','DIGITDIFF'].includes(contractType)) {
        req.barrier = document.getElementById('ticket-barrier').value;
      }
    }

    this.pendingDirection = direction;
    this.currentProposal = null;
    WS.send(req);
    UI.notify('Requesting proposal...');
  },

  handleProposal(proposal) {
    if (!proposal || proposal.error) {
      const msg = proposal?.error?.message || 'Proposal failed';
      UI.notify(msg, 'error');
      return;
    }
    if (BotBuilder.running) { BotBuilder.handleBotProposal(proposal); return; }
    this.currentProposal = proposal;
    const payout = ((proposal.payout / proposal.ask_price - 1) * 100).toFixed(1);
    if (this.pendingDirection === 'up') document.getElementById('ticket-payout-up').textContent = '+' + payout + '%';
    else if (this.pendingDirection === 'down') document.getElementById('ticket-payout-down').textContent = '+' + payout + '%';

    if (App.state.isDemo) { this.simulateContract(proposal); return; }
    const confirm = document.getElementById('setting-confirm').checked;
    if (confirm) {
      if (!window.confirm(`Confirm ${this.currentProposal.contract_type} trade for $${this.currentProposal.ask_price}?`)) return;
    }
    WS.send({ buy: proposal.id, price: proposal.ask_price });
  },

  handleBuy(buy) {
    if (!buy || buy.error) {
      const msg = buy?.error?.message || 'Purchase failed';
      UI.notify(msg, 'error');
      return;
    }
    const contract = {
      id: buy.contract_id,
      symbol: buy.symbol || Markets.activeSymbol,
      type: buy.contract_type || this.currentProposal?.contract_type || 'Unknown',
      category: this.currentCategory,
      stake: parseFloat(buy.buy_price || this.currentProposal?.ask_price || 0),
      entryPrice: Markets.ticks[Markets.activeSymbol]?.price || 0,
      entryTime: Date.now(),
      status: 'OPEN',
      longcode: buy.longcode || ''
    };
    App.state.openContracts.push(contract);
    WS.send({ proposal_open_contract: 1, contract_id: buy.contract_id, subscribe: 1 });
    UI.renderPositions(); UI.updateDashboard();
    UI.notify(`Contract #${buy.contract_id} purchased`);
    if (App.state.soundEnabled) Audio.play('buy');

    if (App.state.jwtToken && App.state.autoSync) {
      API.storeTransaction({
        contractId: String(buy.contract_id),
        symbol: contract.symbol, type: contract.type, category: contract.category,
        stake: contract.stake, currency: App.state.currency,
        entryPrice: contract.entryPrice, status: 'OPEN',
        entryTime: new Date().toISOString(), isVirtual: App.state.isVirtual
      }).catch(() => {});
    }
  },

  handleContractUpdate(poc) {
    const c = App.state.openContracts.find(x => x.id === poc.contract_id);
    if (!c) return;
    c.profit = parseFloat(poc.profit || 0);
    c.exitPrice = poc.exit_tick_display_value ? parseFloat(poc.exit_tick_display_value) : c.exitPrice;
    c.status = (poc.is_expired || poc.is_sold) ? 'CLOSED' : 'OPEN';

    if (c.status === 'CLOSED') {
      App.state.openContracts = App.state.openContracts.filter(x => x.id !== c.id);
      App.state.todayPnl += c.profit;
      App.state.history.unshift({
        time: new Date().toLocaleString(), id: c.id, symbol: c.symbol,
        type: c.type, category: c.category, stake: c.stake,
        entry: c.entryPrice, exit: c.exitPrice || 0,
        profit: c.profit, status: c.profit >= 0 ? 'WON' : 'LOST'
      });
      if (c.profit >= 0) App.state.wins++; else App.state.losses++;

      UI.renderPositions(); UI.renderHistory(); UI.renderDashboard();
      UI.notify(`${c.profit >= 0 ? 'WIN' : 'LOSS'}: ${c.profit >= 0 ? '+' : ''}${c.profit.toFixed(2)} ${App.state.currency}`);
      if (App.state.soundEnabled) Audio.play(c.profit >= 0 ? 'win' : 'loss');

      const martingale = document.getElementById('ticket-martingale').checked;
      if (martingale) {
        const stakeInput = document.getElementById('ticket-stake');
        if (c.profit < 0) {
          this.martingaleStake = parseFloat((c.stake * 2).toFixed(2));
          stakeInput.value = this.martingaleStake;
          UI.notify(`Martingale: stake doubled to ${this.martingaleStake}`);
        } else {
          this.martingaleStake = parseFloat(stakeInput.getAttribute('data-base') || stakeInput.value);
          stakeInput.value = this.martingaleStake;
        }
      }

      if (App.state.jwtToken && App.state.autoSync) {
        API.storeTransaction({
          contractId: String(c.id), symbol: c.symbol, type: c.type, category: c.category,
          stake: c.stake, currency: App.state.currency,
          entryPrice: c.entryPrice, exitPrice: c.exitPrice || 0,
          profit: c.profit, status: c.profit >= 0 ? 'WON' : 'LOST',
          entryTime: new Date(c.entryTime).toISOString(),
          exitTime: new Date().toISOString(), isVirtual: App.state.isVirtual
        }).catch(() => {});
      }
    } else {
      const plEl = document.getElementById(`pos-pl-${c.id}`);
      if (plEl) {
        plEl.textContent = (c.profit >= 0 ? '+' : '') + c.profit.toFixed(2);
        plEl.className = 'pos-pl ' + (c.profit >= 0 ? 'positive' : 'negative');
      }
    }
  },

  simulateContract(proposal) {
    const cfg = {
      symbol: proposal.echo_req.symbol,
      contract_type: proposal.echo_req.contract_type,
      duration: proposal.echo_req.duration,
      duration_unit: proposal.echo_req.duration_unit,
      barrier: proposal.echo_req.barrier,
      stake: proposal.echo_req.amount,
      category: this.currentCategory,
      multiplier: proposal.echo_req.multiplier,
      growth_rate: proposal.echo_req.growth_rate
    };
    const entryPrice = Markets.ticks[cfg.symbol]?.price || 0;
    const fakeId = 'DEMO-' + Date.now();
    const contract = {
      id: fakeId, symbol: cfg.symbol, type: cfg.contract_type, category: cfg.category,
      stake: cfg.stake, entryPrice, entryTime: Date.now(),
      status: 'OPEN', profit: 0, longcode: `[DEMO] ${cfg.contract_type} ${cfg.symbol}`
    };
    App.state.openContracts.push(contract);
    UI.renderPositions(); UI.notify('[DEMO] Contract opened');

    const resolveDelay = cfg.category === 'multipliers' ? 3000 :
      cfg.category === 'accumulators' ? 5000 :
      cfg.duration_unit === 't' ? (cfg.duration || 1) * 1500 :
      (cfg.duration || 1) * 1000 * (cfg.duration_unit === 'm' ? 60 : cfg.duration_unit === 'h' ? 3600 : 1);

    setTimeout(() => {
      const hist = Markets.tickHistory[cfg.symbol];
      const exitTick = hist && hist.length > 0 ? hist[hist.length - 1] : { price: entryPrice };
      const exitPrice = exitTick.price;
      let isWin = false;

      if (cfg.category === 'multipliers') {
        const mult = cfg.multiplier || parseInt(document.getElementById('ticket-multiplier')?.value) || 5;
        const priceChange = (exitPrice - entryPrice) / entryPrice;
        const isUp = cfg.contract_type === 'MULTUP';
        isWin = isUp ? priceChange > 0 : priceChange < 0;
        const magnitude = Math.abs(priceChange);
        let profit = isWin ? cfg.stake * magnitude * mult : -cfg.stake * mult * 0.5;
        profit = Math.max(-cfg.stake * mult, Math.min(cfg.stake * mult * 5, profit));
        contract.profit = profit;
      } else if (cfg.category === 'accumulators') {
        const growthRate = cfg.growth_rate || parseFloat(document.getElementById('ticket-growth-rate')?.value) || 0.01;
        isWin = Math.random() > 0.35;
        contract.profit = isWin ? cfg.stake * (1 + growthRate * 10) : -cfg.stake;
      } else {
        if (cfg.contract_type === 'CALL') isWin = exitPrice > entryPrice;
        else if (cfg.contract_type === 'PUT') isWin = exitPrice < entryPrice;
        else if (cfg.contract_type === 'DIGITOVER') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d > parseInt(cfg.barrier || 5); }
        else if (cfg.contract_type === 'DIGITUNDER') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d < parseInt(cfg.barrier || 5); }
        else if (cfg.contract_type === 'DIGITEVEN') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d % 2 === 0; }
        else if (cfg.contract_type === 'DIGITODD') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d % 2 === 1; }
        else if (cfg.contract_type === 'DIGITMATCH') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d === parseInt(cfg.barrier || 5); }
        else if (cfg.contract_type === 'DIGITDIFF') { const d = Math.floor(exitPrice * 10000) % 10; isWin = d !== parseInt(cfg.barrier || 5); }
        else { isWin = Math.random() > 0.45; }
        contract.profit = isWin ? (cfg.stake * 0.88) : -cfg.stake;
      }
      
      contract.exitPrice = exitPrice; contract.status = 'CLOSED';
      App.state.openContracts = App.state.openContracts.filter(x => x.id !== fakeId);
      App.state.todayPnl += contract.profit;
      App.state.history.unshift({
        time: new Date().toLocaleString(), id: fakeId, symbol: cfg.symbol,
        type: cfg.contract_type, category: cfg.category, stake: cfg.stake,
        entry: entryPrice, exit: exitPrice, profit: contract.profit, status: contract.profit >= 0 ? 'WON' : 'LOST'
      });
      if (contract.profit >= 0) App.state.wins++; else App.state.losses++;

      UI.renderPositions(); UI.renderHistory(); UI.renderDashboard();
      UI.notify(`[DEMO] ${contract.profit >= 0 ? 'WIN' : 'LOSS'} ${contract.profit >= 0 ? '+' : ''}${contract.profit.toFixed(2)}`);
      if (App.state.soundEnabled) Audio.play(contract.profit >= 0 ? 'win' : 'loss');
    }, Math.min(resolveDelay, 5000));
  },

  sell(contractId) {
    if (App.state.isDemo) { UI.notify('Cannot sell in demo mode'); return; }
    WS.send({ sell: contractId });
  }
};

WS.on('proposal', (d) => Trade.handleProposal(d));
WS.on('buy', (d) => Trade.handleBuy(d));
WS.on('proposal_open_contract', (d) => Trade.handleContractUpdate(d));

