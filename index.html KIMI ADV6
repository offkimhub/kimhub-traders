   ═══════════════════════════════════════════════════════════════ */
const GDrive = {
  async connect() {
    if (!App.state.jwtToken) { UI.notify('Please log in first'); return; }
    try {
      const res = await API.getDriveAuthUrl();
      window.open(res.authUrl, '_blank', 'width=500,height=600');
    } catch (err) { UI.notify('Drive auth failed: ' + err.message, 'error'); }
  },
  async listFiles() {
    if (!App.state.gdriveRefreshToken) { UI.notify('Connect Google Drive in Settings first'); return; }
    const listEl = document.getElementById('gdrive-files-list');
    listEl.innerHTML = '<div style="color:var(--text-muted);font-size:0.75rem;">Loading...</div>';
    try {
      const res = await API.listDriveFiles(App.state.gdriveRefreshToken);
      if (!res.files || !res.files.length) { listEl.innerHTML = '<div style="color:var(--text-muted);font-size:0.75rem;">No files found</div>'; return; }
      listEl.innerHTML = res.files.map(f => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:0.4rem;background:rgba(255,255,255,0.03);border-radius:4px;margin-bottom:0.3rem;">
          <span style="font-size:0.78rem;"><i class="fas fa-file" style="margin-right:0.3rem;color:var(--accent-blue);"></i>${f.name}</span>
          <button class="btn btn-green btn-sm" onclick="GDrive.loadFile('${f.id}')"><i class="fas fa-download"></i></button>
        </div>
      `).join('');
    } catch (err) { listEl.innerHTML = `<div style="color:var(--accent-red);font-size:0.75rem;">Error: ${err.message}</div>`; }
  },
  async loadFile(fileId) {
    try {
      const res = await API.downloadDriveFile(fileId, App.state.gdriveRefreshToken);
      if (BotBuilder.deserialize(res.content)) { BotBuilder.hideUpload(); UI.notify('Strategy loaded from Google Drive'); }
    } catch (err) { UI.notify('Load failed: ' + err.message, 'error'); }
  },
  async saveToDrive(filename, content) {
    if (!App.state.gdriveRefreshToken) { UI.notify('Connect Google Drive first'); return; }
    try { await API.uploadToDrive({ filename, content, mimeType: 'application/json', refreshToken: App.state.gdriveRefreshToken }); UI.notify('Saved to Google Drive'); }
    catch (err) { UI.notify('Upload failed: ' + err.message, 'error'); }
  }
};

