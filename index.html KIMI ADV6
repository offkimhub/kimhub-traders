      variable: ['blue', 'fa-database', 'Set Variable'],
      rsi: ['purple', 'fa-wave-square', 'RSI Check'],
      ma: ['green', 'fa-chart-line', 'Moving Average'],
      macd: ['orange', 'fa-wave-square', 'MACD Check'],
      bbands: ['blue', 'fa-chart-area', 'Bollinger Bands']
