const AIAssistant = {
  messages: [],
  toggle() {
    const panel = document.getElementById('ai-panel');
    const btn = document.getElementById('ai-toggle');
    panel.classList.toggle('open');
    btn.classList.toggle('hidden');
  },
  close() {
    document.getElementById('ai-panel').classList.remove('open');
    document.getElementById('ai-toggle').classList.remove('hidden');
  },
  async send() {
    const input = document.getElementById('ai-input');
    const text = input.value.trim();
    if (!text) return;
    this.addMessage(text, 'user');
    input.value = '';
    const context = this.buildContext();
    const messages = [...this.messages.slice(-10), { role: 'user', content: text + (context ? `\n\n[Context: ${context}]` : '') }];
    try {
      const res = await API.chatAI(messages);
      this.addMessage(res.reply, 'bot');
    } catch (err) {
      this.addMessage('Sorry, AI service unavailable. Check backend config.', 'bot');
    }
  },
  addMessage(text, role) {
    const container = document.getElementById('ai-messages');
    const msg = document.createElement('div');
    msg.className = 'ai-msg ' + role;
    msg.innerHTML = role === 'bot' ? `<strong>KimHub AI</strong><br>${text.replace(/\n/g, '<br>')}` : text;
    container.appendChild(msg);
    container.scrollTop = container.scrollHeight;
    this.messages.push({ role, content: text });
    if (this.messages.length > 20) this.messages = this.messages.slice(-20);
  },
  buildContext() {
    const parts = [];
    if (Markets.activeSymbol) parts.push(`Symbol: ${Markets.activeSymbol}`);
    if (App.state.balance) parts.push(`Balance: ${App.state.balance.toFixed(2)} ${App.state.currency}`);
    if (App.state.todayPnl !== 0) parts.push(`Today PnL: ${App.state.todayPnl.toFixed(2)}`);
    const total = App.state.wins + App.state.losses;
    if (total > 0) parts.push(`Win rate: ${Math.round((App.state.wins/total)*100)}% (${App.state.wins}W/${App.state.losses}L)`);
    if (BotBuilder.running) parts.push(`Bot running: ${BotBuilder.stats.wins + BotBuilder.stats.losses} trades`);
    return parts.join(', ');
  },
  async analyzeStrategy() {
    if (!BotBuilder.blocks.length) { UI.notify('Build a strategy first'); return; }
    const strategy = BotBuilder.serialize();
    const stats = BotBuilder.stats;
    this.toggle();
    this.addMessage('Analyzing your current strategy...', 'user');
    try {
      const res = await API.analyzeStrategy(strategy, stats);
      this.addMessage(res.analysis, 'bot');
    } catch (err) {
      this.addMessage('Analysis failed: ' + err.message, 'bot');
    }
  }
};

