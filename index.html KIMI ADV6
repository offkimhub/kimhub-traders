      <div class="bb-field-row"><span class="bb-field-label">Contract</span><select class="bb-field-select" style="flex:1;" id="${block.id}-type"><option value="CALL">Rise</option><option value="PUT">Fall</option><option value="DIGITOVER">Over</option><option value="DIGITUNDER">Under</option><option value="MULTUP">Mult Up</option><option value="MULTDOWN">Mult Down</option><option value="ACCU">Accumulator</option></select></div>
      <div class="bb-field-row"><span class="bb-field-label">Stake</span><input type="number" class="bb-field-input" value="1.00" id="${block.id}-stake"></div>
      <div class="bb-field-row"><span class="bb-field-label">Duration</span><input type="number" class="bb-field-input" value="1" id="${block.id}-dur"><select class="bb-field-select" style="width:80px;" id="${block.id}-durunit"><option value="t">Ticks</option><option value="m">Minutes</option></select></div>`;
    } else if (type === 'purchase') {
      body.innerHTML = `<div class="bb-field-row"><span class="bb-field-label">Direction</span><select class="bb-field-select" style="flex:1;" id="${block.id}-dir"><option value="CALL">Rise</option><option value="PUT">Fall</option></select></div>`;
    } else if (type === 'restart') {
      body.innerHTML = `<div class="bb-field-row"><span class="bb-field-label">Max Loss</span><input type="number" class="bb-field-input" value="5.00" id="${block.id}-sl"></div>
      <div class="bb-field-row"><span class="bb-field-label">Take Profit</span><input type="number" class="bb-field-input" value="10.00" id="${block.id}-tp"></div>
      <div class="bb-field-row"><span class="bb-field-label">Martingale</span><input type="checkbox" id="${block.id}-mart" style="accent-color:var(--accent-green);width:16px;height:16px;"></div>`;
    } else if (type === 'sell') {
      body.innerHTML = `<div class="bb-field-row"><span class="bb-field-label">If Profit ></span><input type="number" class="bb-field-input" value="0.50" id="${block.id}-sellat"></div>`;
    } else if (type === 'rsi') {
      body.innerHTML = `<div class="bb-field-row"><span class="bb-field-label">Period</span><input type="number" class="bb-field-input" value="14" id="${block.id}-period"></div>
      <div class="bb-field-row"><span class="bb-field-label">Overbought ></span><input type="number" class="bb-field-input" value="70" id="${block.id}-over"></div>
      <div class="bb-field-row"><span class="bb-field-label">Oversold <</span><input type="number" class="bb-field-input" value="30" id="${block.id}-under"></div>`;
    } else if (type === 'ma') {
      body.innerHTML = `<div class="bb-field-row"><span class="bb-field-label">Period</span><input type="number" class="bb-field-input" value="20" id="${block.id}-period"></div>
      <div class="bb-field-row"><span class="bb-field-label">Type</span><select class="bb-field-select" style="flex:1;" id="${block.id}-matype"><option value="sma">SMA</option><option value="ema">EMA</option></select></div>`;
    } else {
      body.innerHTML = `<div style="color:var(--text-muted);font-size:0.75rem;">Configure this block in advanced mode.</div>`;
    }
    stack.appendChild(block);
    this.blocks.push({ id: block.id, type });
  },

  checkEmpty() {
    const stack = document.getElementById('bb-stack');
    if (!stack.children.length) {
      stack.innerHTML = `<div style="text-align:center;color:var(--text-muted);padding:3rem 1rem;"><i class="fas fa-cubes" style="font-size:2.5rem;margin-bottom:1rem;display:block;opacity:0.3;"></i><p style="font-size:0.85rem;">Your strategy workspace is empty.</p><p style="font-size:0.75rem;margin-top:0.5rem;">Click blocks from the toolbox to build your bot.</p><button class="btn btn-green btn-sm" style="margin-top:1rem;" onclick="BotBuilder.loadQuick('martingale')"><i class="fas fa-magic"></i> Load Quick Strategy</button></div>`;
    }
  },

  loadQuick(strategy) {
    document.getElementById('bb-stack').innerHTML = '';
    this.blocks = [];
    this.addBlock('trade_params');
    this.addBlock('purchase');
    this.addBlock('restart');
    if (strategy === 'martingale') {
      const last = this.blocks[this.blocks.length-1];
      const cb = document.getElementById(last.id + '-mart');
      if (cb) cb.checked = true;
    }
    this.log(`Loaded quick strategy: ${strategy}`, 'info');
    App.state.currentBotId = null;
  },

  serialize() {
    const blocks = [];
    document.querySelectorAll('.bb-block').forEach(b => {
      const type = this.blocks.find(x => x.id === b.id)?.type;
      if (!type) return;
      const data = {};
      b.querySelectorAll('input, select').forEach(el => {
        const key = el.id.replace(b.id + '-', '');
        data[key] = el.type === 'checkbox' ? el.checked : el.value;
      });
      blocks.push({ type, id: b.id, data });
    });
    return JSON.stringify({ blocks, version: '1.0' });
  },

  deserialize(jsonStr) {
    try {
      const obj = JSON.parse(jsonStr);
      document.getElementById('bb-stack').innerHTML = '';
      this.blocks = [];
      (obj.blocks || []).forEach(b => {
        this.addBlock(b.type);
        const lastBlock = document.getElementById(this.blocks[this.blocks.length-1].id);
        if (lastBlock && b.data) {
          Object.keys(b.data).forEach(key => {
            const el = lastBlock.querySelector(`[id$="-${key}"]`);
            if (el) {
              if (el.type === 'checkbox') el.checked = b.data[key];
              else el.value = b.data[key];
            }
          });
        }
      });
      return true;
    } catch (e) {
      UI.notify('Failed to load strategy: ' + e.message, 'error');
      return false;
    }
  },

  async save() {
    if (!App.state.jwtToken) { UI.notify('Please log in to save bots to the cloud'); return; }
    const name = window.prompt('Name your strategy:', App.state.currentBotId ? '' : 'My Strategy');
    if (!name) return;

    const strategyData = this.serialize();
    const tp = this.blocks.find(b => b.type === 'trade_params');
    let params = {};
    if (tp) {
      const symEl = document.getElementById(tp.id + '-sym');
      const typeEl = document.getElementById(tp.id + '-type');
      const stakeEl = document.getElementById(tp.id + '-stake');
      const durEl = document.getElementById(tp.id + '-dur');
      const durUnitEl = document.getElementById(tp.id + '-durunit');
      params = {
        symbol: symEl?.value || 'R_100',
        contractType: typeEl?.value || 'CALL',
        stake: parseFloat(stakeEl?.value) || 1.00,
        duration: parseInt(durEl?.value) || 1,
        durationUnit: durUnitEl?.value || 't'
      };
    }

    try {
      let result;
      if (App.state.currentBotId) {
        result = await API.updateBot(App.state.currentBotId, { name, strategyData, ...params });
        UI.notify('Strategy updated successfully');
      } else {
        result = await API.createBot({ name, strategyData, strategyFormat: 'json', ...params });
        App.state.currentBotId = result._id;
        UI.notify('Strategy saved to cloud');
      }
    } catch (err) {
      UI.notify('Save failed: ' + err.message, 'error');
    }
  },

  async loadLibrary() {
    if (!App.state.jwtToken) { UI.notify('Please log in to load saved bots'); return; }
    document.getElementById('bot-lib-modal').classList.add('active');
    document.getElementById('bot-lib-grid').innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:2rem;">Loading...</div>';
    try {
      const res = await API.getBots('limit=50');
      this.renderLibrary(res.bots || []);
    } catch (err) {
      document.getElementById('bot-lib-grid').innerHTML = `<div style="grid-column:1/-1;text-align:center;color:var(--accent-red);padding:2rem;">Error: ${err.message}</div>`;
    }
  },

  renderLibrary(bots) {
    const grid = document.getElementById('bot-lib-grid');
    if (!bots.length) {
      grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:2rem;">No saved bots yet. Create and save your first strategy!</div>';
      return;
    }
    grid.innerHTML = bots.map(bot => `
      <div class="bot-lib-card" data-name="${bot.name.toLowerCase()}">
        <h4>${bot.name}</h4>
        <p>${bot.description || 'No description'} • ${bot.symbol || 'R_100'} • ${bot.contractType || 'CALL'}</p>
        <div style="font-size:0.7rem;color:var(--text-muted);margin-bottom:0.5rem;">
          Runs: ${bot.runCount} • ${new Date(bot.updatedAt).toLocaleDateString()}
        </div>
        <div class="bot-lib-actions">
          <button class="btn btn-green btn-sm" onclick="BotBuilder.loadFromCloud('${bot._id}')"><i class="fas fa-folder-open"></i> Load</button>
          <button class="btn btn-ghost btn-sm" onclick="BotBuilder.cloneCloud('${bot._id}')"><i class="fas fa-copy"></i></button>
          <button class="btn btn-ghost btn-sm" onclick="BotBuilder.renameCloud('${bot._id}', '${bot.name.replace(/'/g, "\\'")}')"><i class="fas fa-edit"></i></button>
          <button class="btn btn-red btn-sm" onclick="BotBuilder.deleteCloud('${bot._id}')"><i class="fas fa-trash"></i></button>
        </div>
      </div>
    `).join('');
  },

  filterLibrary(term) {
    const t = term.toLowerCase();
    document.querySelectorAll('.bot-lib-card').forEach(el => {
      el.style.display = el.dataset.name.includes(t) ? 'block' : 'none';
    });
  },

  hideLibrary() { document.getElementById('bot-lib-modal').classList.remove('active'); },

  async loadFromCloud(id) {
    try {
      const bot = await API.getBot(id);
      if (bot.strategyData && this.deserialize(bot.strategyData)) {
        App.state.currentBotId = bot._id;
        UI.notify(`Loaded: ${bot.name}`);
        this.hideLibrary();
      }
    } catch (err) { UI.notify('Load failed: ' + err.message, 'error'); }
  },

  async cloneCloud(id) {
    try {
      const clone = await API.cloneBot(id);
      UI.notify(`Cloned: ${clone.name}`);
      this.loadLibrary();
    } catch (err) { UI.notify('Clone failed: ' + err.message, 'error'); }
  },

  async renameCloud(id, currentName) {
    const name = window.prompt('New name:', currentName);
    if (!name) return;
    try {
      await API.renameBot(id, name);
      UI.notify('Renamed successfully');
      this.loadLibrary();
    } catch (err) { UI.notify('Rename failed: ' + err.message, 'error'); }
  },

  async deleteCloud(id) {
    if (!window.confirm('Delete this bot permanently?')) return;
    try {
      await API.deleteBot(id);
      if (App.state.currentBotId === id) App.state.currentBotId = null;
      UI.notify('Bot deleted');
      this.loadLibrary();
    } catch (err) { UI.notify('Delete failed: ' + err.message, 'error'); }
  },

  async exportBot() {
    if (!App.state.currentBotId) {
      const data = this.serialize();
      const blob = new Blob([data], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `strategy_${Date.now()}.json`; a.click();
      URL.revokeObjectURL(url);
      UI.notify('Strategy exported as JSON');
      return;
    }
    window.open(API.exportBotJSON(App.state.currentBotId), '_blank');
  },

  showUpload() { document.getElementById('upload-modal').classList.add('active'); },
  hideUpload() { document.getElementById('upload-modal').classList.remove('active'); },

  handleDrop(e) {
    e.preventDefault();
    const files = e.dataTransfer.files;
    if (files.length) this.processFile(files[0]);
  },

  handleFileSelect(e) {
    const files = e.target.files;
    if (files.length) this.processFile(files[0]);
  },

  async processFile(file) {
    const text = await file.text();
    const ext = file.name.split('.').pop().toLowerCase();

    if (App.state.jwtToken) {
      try {
        const bot = await API.importBot(ext, text, file.name.replace('.' + ext, ''));
        this.loadFromCloud(bot._id);
        this.hideUpload();
        UI.notify('Strategy imported to cloud');
        return;
      } catch (err) {}
    }

    if (ext === 'json') {
      if (this.deserialize(text)) {
        this.hideUpload();
        UI.notify('Strategy loaded locally');
      }
    } else {
      UI.notify('XML import requires backend processing', 'error');
    }
  },

  run() {
    if (this.running) return;
    if (!App.state.authenticated) { UI.notify('Connect or enter demo mode first'); return; }
    this.running = true; this.state = 'RUNNING';
    document.getElementById('bb-run-btn').style.display = 'none';
    document.getElementById('bb-stop-btn').style.display = 'inline-flex';
    document.getElementById('drawer-run-btn').disabled = true;
    document.getElementById('drawer-run-btn').innerHTML = '<i class="fas fa-stop"></i> Stop';
    document.getElementById('drawer-run-btn').onclick = () => BotBuilder.stop();
    const status = document.getElementById('bb-status');
    status.innerHTML = '<span class="status-dot running"></span> Bot is running...';
    status.classList.add('running');
    document.getElementById('drawer-status-text').textContent = 'Bot is running...';
    document.getElementById('drawer-timeline').style.width = '60%';
    this.log('Bot started', 'info');
    if (App.state.soundEnabled) Audio.play('buy');
    this.executeLoop();
  },

  stop() {
    this.running = false; this.state = 'IDLE';
    if (this.timer) clearTimeout(this.timer);
    document.getElementById('bb-run-btn').style.display = 'inline-flex';
    document.getElementById('bb-stop-btn').style.display = 'none';
    document.getElementById('drawer-run-btn').disabled = false;
    document.getElementById('drawer-run-btn').innerHTML = '<i class="fas fa-play"></i> Run';
    document.getElementById('drawer-run-btn').onclick = () => BotBuilder.run();
    const status = document.getElementById('bb-status');
    status.innerHTML = '<span class="status-dot"></span> Bot is not running';
    status.classList.remove('running');
    document.getElementById('drawer-status-text').textContent = 'Bot is not running';
    document.getElementById('drawer-timeline').style.width = '0%';
    this.log('Bot stopped', 'info');
  },

  reset() { this.stop(); document.getElementById('bb-stack').innerHTML = ''; this.blocks = []; this.checkEmpty(); this.resetStats(); this.log('Workspace reset', 'info'); App.state.currentBotId = null; },

  executeLoop() {
    if (!this.running) return;
    const tp = this.blocks.find(b => b.type === 'trade_params');
    if (!tp) { this.log('No Trade Parameters block found', 'loss'); this.stop(); return; }

    const sym = document.getElementById(tp.id + '-sym')?.value || 'R_100';
    const type = document.getElementById(tp.id + '-type')?.value || 'CALL';
    const stake = parseFloat(document.getElementById(tp.id + '-stake')?.value) || 0.35;
    const dur = parseInt(document.getElementById(tp.id + '-dur')?.value) || 1;
    const durUnit = document.getElementById(tp.id + '-durunit')?.value || 't';

    if (Markets.activeSymbol !== sym) Markets.subscribe(sym);
    const req = { proposal: 1, amount: stake, basis: 'stake', contract_type: type, currency: App.state.currency, duration: dur, duration_unit: durUnit, symbol: sym };
    WS.send(req);
    this.log(`Proposal: ${type} ${sym} @ ${stake}`, 'info');
    this.timer = setTimeout(() => this.executeLoop(), 5000);
  },

  handleBotProposal(proposal) {
    if (!this.running || !proposal || !proposal.id) return;
    if (App.state.isDemo) { Trade.simulateContract(proposal); this.updateBotStats(proposal); return; }
    WS.send({ buy: proposal.id, price: proposal.ask_price });
    this.updateBotStats(proposal);
  },

  updateBotStats(proposal) {
    this.stats.stake += parseFloat(proposal.ask_price || 0);
    this.stats.payout += parseFloat(proposal.payout || 0);
    document.getElementById('bb-sum-stake').textContent = this.stats.stake.toFixed(2);
    document.getElementById('bb-sum-payout').textContent = this.stats.payout.toFixed(2);
  },

  updateBotResult(profit) {
    this.stats.pnl += profit;
    if (profit >= 0) this.stats.wins++; else this.stats.losses++;
    const total = this.stats.wins + this.stats.losses;
    document.getElementById('bb-sum-wins').textContent = this.stats.wins;
    document.getElementById('bb-sum-losses').textContent = this.stats.losses;
    document.getElementById('bb-sum-winrate').textContent = total > 0 ? Math.round((this.stats.wins/total)*100) + '%' : '0%';
    const pnlEl = document.getElementById('bb-sum-pnl');
    pnlEl.textContent = (this.stats.pnl >= 0 ? '+' : '') + this.stats.pnl.toFixed(2);
    pnlEl.style.color = this.stats.pnl >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';
    this.log(`${profit >= 0 ? 'WIN' : 'LOSS'} ${profit >= 0 ? '+' : ''}${profit.toFixed(2)}`, profit >= 0 ? 'win' : 'loss');
  },

  resetStats() {
    this.stats = { stake: 0, payout: 0, wins: 0, losses: 0, pnl: 0 };
    document.getElementById('bb-sum-stake').textContent = '0.00';
    document.getElementById('bb-sum-payout').textContent = '0.00';
    document.getElementById('bb-sum-wins').textContent = '0';
    document.getElementById('bb-sum-losses').textContent = '0';
    document.getElementById('bb-sum-winrate').textContent = '0%';
    document.getElementById('bb-sum-pnl').textContent = '0.00';
    document.getElementById('bb-sum-pnl').style.color = 'var(--text-primary)';
  },

  log(msg, type = 'info') {
    const log = document.getElementById('bb-journal-log');
    if (log.querySelector('div')?.textContent === 'Journal is empty') log.innerHTML = '';
    const entry = document.createElement('div');
    entry.className = 'bb-log-entry ' + type;
    entry.innerHTML = `<span class="ts">${new Date().toLocaleTimeString()}</span> ${msg}`;
    log.appendChild(entry); log.scrollTop = log.scrollHeight;
  }
};

// Hook bot builder into trade events
const origHandleBuy = Trade.handleBuy.bind(Trade);
Trade.handleBuy = function(buy) {
  origHandleBuy(buy);
  if (BotBuilder.running) BotBuilder.log(`BUY Contract #${buy.contract_id}`, 'buy');
};
const origHandleContract = Trade.handleContractUpdate.bind(Trade);
Trade.handleContractUpdate = function(poc) {
  const c = App.state.openContracts.find(x => x.id === poc.contract_id);
  const wasOpenBefore = c && c.status === 'OPEN';
  origHandleContract(poc);
  if (BotBuilder.running && wasOpenBefore && (poc.is_expired || poc.is_sold)) {
    BotBuilder.updateBotResult(c.profit);
  }
};

